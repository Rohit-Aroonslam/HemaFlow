@model Project.Models.Doctor.DoctorAddPatientModel
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Add New Patient";
    var today = Project.Services.SastTime.ToSast(DateTime.UtcNow).ToString("yyyy-MM-dd");
}

<div class="mb-4">
    <a asp-controller="Doctor" asp-action="CreateTestRequest" class="btn btn-sm btn-outline-secondary rounded-3 px-3 mb-3">
        <i class="bi bi-arrow-left me-1"></i> Back to New Request
    </a>
    <h4 class="fw-700 mb-1" style="color: #0f172a;">Add New Patient</h4>
    <p class="text-muted mb-0">Register a new patient on the system.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-5">
            <form method="post" asp-controller="Doctor" asp-action="AddPatient" id="addPatientForm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">First Name(s) <span class="text-danger">*</span></label>
                        <input type="text" name="FirstName" class="form-control" placeholder="Enter first name" value="@Model.FirstName" maxlength="100" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Surname <span class="text-danger">*</span></label>
                        <input type="text" name="Surname" class="form-control" placeholder="Enter surname" value="@Model.Surname" maxlength="100" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">SA ID Number <span class="text-danger">*</span></label>
                        <input type="text" id="saIdNumber" name="SaIdNumber" class="form-control" value="@Model.SaIdNumber"
                               placeholder="YYMMDDSSSSCAZ" maxlength="13" minlength="13" inputmode="numeric" pattern="[0-9]{13}" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Date of Birth <span class="text-danger">*</span></label>
                        <input type="date" id="dateOfBirth" name="DateOfBirth" class="form-control bg-light" max="@today" readonly required
                               value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))">
                        <small class="text-muted d-block mt-1" style="font-size:0.68rem;">Auto-filled from the SA ID number.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                        <input type="tel" name="Phone" class="form-control" value="@Model.Phone" placeholder="0821234567"
                               maxlength="10" inputmode="numeric" pattern="[0-9]{10}" required oninput="this.value=this.value.replace(/[^0-9]/g,'')">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="Email" class="form-control" placeholder="patient@example.com" value="@Model.Email" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Complex / Building Name <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="text" name="Complex" class="form-control" placeholder="e.g. Sunset Heights, Flat 4B" value="@Model.Complex" maxlength="100">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">House &amp; Street Address <span class="text-danger">*</span></label>
                        <input type="text" name="Street" class="form-control" placeholder="e.g. 12 Kestrel Road" value="@Model.Street" maxlength="100" required>
                    </div>

                    <div class="col-12">
                        <partial name="_AddressPicker" model="new Project.Models.AddressPickerModel { SuburbId = Model.SuburbId, City = Model.City, Suburb = Model.Suburb, PostalCode = Model.PostalCode }" />
                    </div>

                    <div class="col-12">
                        <div class="alert alert-light border small">
                            <i class="bi bi-info-circle me-2"></i>
                            A temporary password will be generated and e-mailed to the patient. They must change it the first time they sign in.
                        </div>
                    </div>
                    <div class="col-12 d-flex gap-3">
                        <button type="button" class="btn btn-dark rounded-3 px-5" onclick="confirmSavePatient()">
                            <i class="bi bi-person-check me-2"></i>Save Patient
                        </button>
                        <a asp-action="CreateTestRequest" asp-controller="Doctor" class="btn btn-outline-secondary rounded-3 px-4">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:0; border:1px solid #e1e1e1;">
            <div class="modal-header border-bottom" style="padding:1.25rem 1.5rem;">
                <h6 class="modal-title fw-bold mb-0">Confirm New Patient</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.5rem;">
                <p class="text-muted small mb-0">
                    Add this patient to the system? A welcome e-mail with a temporary password will be sent to them.
                </p>
            </div>
            <div class="modal-footer border-top" style="padding:1rem 1.5rem; gap:0.5rem;">
                <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmBtn" class="btn btn-dark rounded-3 px-4"
                        onclick="this.disabled = true; document.getElementById('addPatientForm').submit()">
                    <i class="bi bi-person-check me-2"></i>Confirm
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const idInput = document.getElementById('saIdNumber');
            const dobInput = document.getElementById('dateOfBirth');
            idInput.addEventListener('input', function () {
                this.value = this.value.replace(/\D/g, '');
                const idNum = this.value;
                if (/^\d{6}/.test(idNum)) {
                    const yy = parseInt(idNum.substring(0, 2), 10);
                    const mm = idNum.substring(2, 4);
                    const dd = idNum.substring(4, 6);
                    const monthNum = parseInt(mm, 10), dayNum = parseInt(dd, 10);
                    if (monthNum >= 1 && monthNum <= 12 && dayNum >= 1 && dayNum <= 31) {
                        const currentYearTwoDigits = parseInt(new Date().getFullYear().toString().substring(2), 10);
                        const fullYear = (yy <= currentYearTwoDigits) ? (2000 + yy) : (1900 + yy);
                        dobInput.value = `${fullYear}-${mm}-${dd}`;
                    }
                }
            });
        });

        function confirmSavePatient() {
            const form = document.getElementById('addPatientForm');
            if (!form.reportValidity()) return;
            new bootstrap.Modal(document.getElementById('confirmModal')).show();
        }
    </script>
}
