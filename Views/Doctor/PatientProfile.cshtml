@model Project.Models.Entities.PatientProfile
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Patient Profile";
}

@if (Model == null)
{
    <div class="alert alert-warning rounded-3 my-4">
        <i class="bi bi-exclamation-circle me-2"></i>Patient profile could not be loaded.
        <a asp-controller="Doctor" asp-action="Patients" class="alert-link ms-2">Return to Patients List</a>
    </div>
}
else
{
    <div class="mb-4">
        <a asp-controller="Doctor" asp-action="Patients" class="btn btn-sm btn-outline-secondary rounded-3 px-3 mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Patients
        </a>
        <div class="d-flex justify-content-between align-items-end">
            <div>
                <h4 class="fw-700 mb-0" style="color: #0f172a;">@Model.User?.FirstName @Model.User?.Surname</h4>
                <p class="text-muted mb-0">SA ID: @Model.IdNumber</p>
            </div>
            <a asp-controller="Doctor" asp-action="CreateTestRequest" asp-route-patientId="@Model.UserId"
               class="btn btn-dark rounded-3 px-4 shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>New Test Request
            </a>
        </div>
    </div>

    <div class="row g-4">

        <!-- Personal Info -->
        <div class="col-md-4">
            <div class="glass-card p-4 h-100">
                <h6 class="text-muted text-uppercase fw-bold small mb-3">Personal Details</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <i class="bi bi-calendar3 me-2 text-muted"></i>DOB: @(Model.DateOfBirth.HasValue? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "N/A")
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-phone me-2 text-muted"></i>@(Model.User?.Phone ?? "N/A")
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-envelope me-2 text-muted"></i>@(Model.User?.Email ?? "N/A")
                    </li>
                </ul>
            </div>
        </div>

        <!-- Medical Conditions -->
        <div class="col-md-4">
            <div class="glass-card p-4 h-100">
                <h6 class="text-muted text-uppercase fw-bold small mb-3">Medical Conditions</h6>
                @if (Model.PatientConditions != null && Model.PatientConditions.Any())
                {
                    foreach (var c in Model.PatientConditions)
                    {
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-3 px-3 me-1 mb-2">
                            @c.Condition?.Name
                        </span>
                    }
                }
                else
                {
                    <p class="text-muted small mt-2 mb-0">No conditions recorded.</p>
                }
            </div>
        </div>

        <!-- Allergies -->
        <div class="col-md-4">
            <div class="glass-card p-4 h-100">
                <h6 class="text-muted text-uppercase fw-bold small mb-3">Allergies</h6>
                @if (Model.PatientAllergies != null && Model.PatientAllergies.Any())
                {
                    foreach (var a in Model.PatientAllergies)
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-3 px-3 me-1 mb-2">
                            @a.Allergy?.Name
                        </span>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">No allergies recorded.</p>
                }
            </div>
        </div>

        <!-- Current Medication -->
        <div class="col-md-6">
            <div class="glass-card p-4">
                <h6 class="text-muted text-uppercase fw-bold small mb-3">Current Medication</h6>
                @if (Model.PatientMedications != null && Model.PatientMedications.Any())
                {
                    foreach (var m in Model.PatientMedications)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-3 px-3 me-1 mb-2">
                            @m.Medication?.Name
                        </span>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">No medications recorded.</p>
                }
            </div>
        </div>

        <!-- Test Request History -->
        <div class="col-md-6">
            <div class="glass-card p-4">
                <h6 class="text-muted text-uppercase fw-bold small mb-3">Recent Test Requests</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>REQUEST #</th>
                                <th>DATE</th>
                                <th>STATUS</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var reqs = ViewBag.Requests as List<Project.Models.Entities.DoctorRequestItem> ?? new(); }
                            @if (reqs.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-muted small text-center">No requests yet.</td>
                                </tr>
                            }
                            @foreach (var r in reqs)
                            {
                                var badge = r.Status switch
                                {
                                    "Completed" => "badge-completed",
                                    "In Progress" => "badge-inprogress",
                                    "Awaiting Release" => "badge-awaiting-release",
                                    "Cancelled" => "bg-secondary-subtle text-secondary",
                                    _ => "badge-submitted"
                                };
                                <tr>
                                    <td class="fw-bold">#REQ-@r.TestRequestId.ToString("D3")</td>
                                    <td>@r.OrderDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge @badge rounded-pill px-3">@r.Status</span></td>
                                    <td class="text-end"><a asp-controller="Doctor" asp-action="RequestDetails" asp-route-id="@r.TestRequestId" class="btn btn-sm btn-link text-dark text-decoration-none">View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
}