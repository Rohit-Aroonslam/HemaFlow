@model IEnumerable<Project.Models.Entities.PatientProfile>
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "My Patients";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h4 class="fw-700 mb-1" style="color: #0f172a;">My Patients</h4>
        <p class="text-muted mb-0">Patients you have ordered tests for.</p>
    </div>
</div>

<div class="glass-card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="searchInput" class="form-control border-0 bg-transparent"
                       placeholder="Search by name or ID number..."
                       oninput="handleFilterChange()">
            </div>
        </div>

        <div class="col-md-3">
            <select id="alphabetGroupFilter" class="form-select border-0 bg-transparent" onchange="handleFilterChange()">
                <option value="">Group by Last Name (All)</option>
                <option value="A-E">A – E</option>
                <option value="F-J">F – J</option>
                <option value="K-O">K – O</option>
                <option value="P-T">P – T</option>
                <option value="U-Z">U – Z</option>
            </select>
        </div>

        <div class="col-md-3">
            <select id="surnameFilter" class="form-select border-0 bg-transparent" onchange="handleFilterChange()">
                <option value="">Filter by Surname (Single Letter)</option>
                @foreach (var letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
                {
                    <option value="@letter">@letter</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <button class="btn btn-outline-secondary rounded-3 px-3 w-100" onclick="clearFilters()">
                <i class="bi bi-x-circle me-1"></i>Clear
            </button>
        </div>
    </div>
</div>

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="patientsTable">
            <thead>
                <tr class="text-muted small">
                    <th>PATIENT NAME</th>
                    <th>SA ID NUMBER</th>
                    <th>CONTACT</th>
                    <th>EMAIL</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody id="patientsBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var fullName = $"{item.User?.FirstName} {item.User?.Surname}".Trim();
                        var surnameLetter = !string.IsNullOrEmpty(item.User?.Surname) ? item.User.Surname[..1].ToUpper() : "";

                        <tr data-name="@fullName" data-id="@item.IdNumber" data-surname="@surnameLetter">
                            <td><span class="fw-bold">@fullName</span></td>
                            <td>@item.IdNumber</td>
                            <td>@(item.User?.Phone ?? "N/A")</td>
                            <td>@(item.User?.Email ?? "N/A")</td>
                            <td class="text-end">
                                <a asp-action="PatientProfile" asp-controller="Doctor" asp-route-id="@item.UserId"
                                   class="btn btn-sm btn-light border-0 text-muted rounded-3 px-3 view-profile-btn">
                                    View Profile
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No patients registered.</td>
                    </tr>
                }
            </tbody>
        </table>

        <div id="noResults" class="text-center text-muted py-4" style="display:none;">
            <i class="bi bi-person-x fs-3 d-block mb-2 opacity-50"></i>
            No patients found matching your criteria.
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top" id="paginationControls">
        <div class="small text-muted" id="paginationInfo">
            Showing 10 patients on this page
        </div>
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item" id="prevPageItem">
                    <button class="page-link text-dark border-0 bg-transparent" onclick="changePage(-1)" aria-label="Previous">
                        <i class="bi bi-chevron-left me-1"></i> Previous
                    </button>
                </li>
                <li class="page-item" id="nextPageItem">
                    <button class="page-link text-dark border-0 bg-transparent" onclick="changePage(1)" aria-label="Next">
                        Next <i class="bi bi-chevron-right ms-1"></i>
                    </button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<style>
    .view-profile-btn {
        background-color: transparent !important;
        transition: all 0.15s ease-in-out;
    }

        .view-profile-btn:hover {
            border: 1px solid #cbd5e1 !important;
            color: #0f172a !important;
            background-color: #f8fafc !important;
        }
</style>

@section Scripts {
    <script>
        let currentPage = 1;
        const recordsPerPage = 10;
        let filteredRows = [];

        document.addEventListener("DOMContentLoaded", function () {
            handleFilterChange();
        });

        function handleFilterChange() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const alphabetGroup = document.getElementById('alphabetGroupFilter').value;
            const singleSurname = document.getElementById('surnameFilter').value.toUpperCase();
            const allRows = document.querySelectorAll('#patientsBody tr');

            filteredRows = [];

            allRows.forEach(row => {
                const name = row.dataset.name?.toLowerCase() || '';
                const id = row.dataset.id?.toLowerCase() || '';
                const surnameLetter = row.dataset.surname?.toUpperCase() || '';

                const matchesSearch = !search || name.includes(search) || id.includes(search);
                const matchesSingleSurname = !singleSurname || surnameLetter === singleSurname;

                let matchesAlphabetGroup = true;
                if (alphabetGroup) {
                    const parts = alphabetGroup.split('-');
                    const startLetter = parts[0];
                    const endLetter = parts[1];
                    matchesAlphabetGroup = (surnameLetter >= startLetter && surnameLetter <= endLetter);
                }

                if (matchesSearch && matchesSingleSurname && matchesAlphabetGroup) {
                    filteredRows.push(row);
                } else {
                    row.style.display = 'none';
                }
            });

            currentPage = 1;
            renderPaginatedTable();
        }

        function renderPaginatedTable() {
            const totalRecords = filteredRows.length;

            if (totalRecords === 0) {
                document.getElementById('noResults').style.display = 'block';
                document.getElementById('paginationControls').style.opacity = '0';
                return;
            }

            document.getElementById('noResults').style.display = 'none';
            document.getElementById('paginationControls').style.opacity = '1';

            const totalPages = Math.ceil(totalRecords / recordsPerPage) || 1;

            if (currentPage < 1) currentPage = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            const startIndex = (currentPage - 1) * recordsPerPage;
            const endIndex = Math.min(startIndex + recordsPerPage, totalRecords);

            filteredRows.forEach((row, index) => {
                if (index >= startIndex && index < endIndex) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            const visibleCountOnCurrentPage = endIndex - startIndex;
            document.getElementById('paginationInfo').textContent =
                `Showing ${visibleCountOnCurrentPage} patients on this page`;

            document.getElementById('prevPageItem').classList.toggle('disabled', currentPage === 1);
            document.getElementById('nextPageItem').classList.toggle('disabled', currentPage === totalPages);
        }

        function changePage(direction) {
            currentPage += direction;
            renderPaginatedTable();
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('surnameFilter').value = '';
            document.getElementById('alphabetGroupFilter').value = '';
            handleFilterChange();
        }
    </script>
}