@model Project.Models.Entities.DoctorRequestItem
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Request Detail";

    var statusLower = Model?.Status?.ToLower() ?? "submitted";
    var badgeClass = statusLower switch
    {
        "completed" => "badge-completed",
        "in progress" => "badge-inprogress",
        "awaiting release" => "badge-awaiting-release",
        "cancelled" => "bg-secondary-subtle text-secondary",
        _ => "badge-submitted"
    };

    var priorityClass = Model?.Urgency?.ToLower() switch
    {
        "stat" => "badge-stat",
        "urgent" => "badge-urgent",
        _ => "badge-routine"
    };
}

<div class="mb-4">
    <a asp-controller="Doctor" asp-action="TrackRequests" class="btn btn-sm btn-outline-secondary rounded-3 px-3 mb-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Requests
    </a>
    <div class="d-flex justify-content-between align-items-center">
        <h4 class="fw-700 mb-0" style="color: #0f172a;">Request #REQ-@(Model?.TestRequestId.ToString("D3"))</h4>
        <div class="d-flex gap-2 align-items-center">
            @if (Model != null && Model.HasResults)
            {
                <a asp-controller="Doctor" asp-action="ViewResults" asp-route-id="@Model.TestRequestId" class="btn btn-dark rounded-3 px-4">
                    <i class="bi bi-clipboard2-data me-2"></i>View Results
                </a>
            }
            @if (Model != null && Model.CanCancel)
            {
                <button type="button" class="btn btn-outline-danger rounded-3 px-4" data-bs-toggle="modal" data-bs-target="#cancelModal">
                    <i class="bi bi-x-circle me-2"></i>Cancel Request
                </button>
            }
            <span class="badge @badgeClass rounded-pill px-4 py-2">@(Model?.Status)</span>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Request Info -->
    <div class="col-md-6">
        <div class="glass-card p-4 h-100">
            <h6 class="text-muted text-uppercase fw-bold small mb-3">Request Details</h6>
            <dl class="info-grid">
                <dt>Patient</dt>
                <dd><strong>@(Model?.PatientName)</strong></dd>
                <dt>Date</dt>
                <dd>@(Model?.OrderDate.ToString("yyyy-MM-dd HH:mm"))</dd>
                <dt>Urgency</dt>
                <dd><span class="badge @priorityClass rounded-pill px-3">@(Model?.Urgency)</span></dd>
                <dt>Status</dt>
                <dd><span class="badge @badgeClass rounded-pill px-3">@(Model?.Status)</span></dd>
            </dl>
        </div>
    </div>

    <!-- Clinical Notes -->
    <div class="col-md-6">
        <div class="glass-card p-4 h-100">
            <h6 class="text-muted text-uppercase fw-bold small mb-3">Clinical Notes</h6>
            <p class="small mb-0 text-muted">@(string.IsNullOrWhiteSpace(Model?.ClinicalNotes) ? "No clinical notes were added to this request." : Model.ClinicalNotes)</p>
            @if (!string.IsNullOrWhiteSpace(Model?.CancelReason))
            {
                <p class="small mb-0 mt-3"><strong class="text-danger">Cancelled:</strong> @Model.CancelReason</p>
            }
        </div>
    </div>

    <!-- Tests Requested -->
    <div class="col-12">
        <div class="glass-card p-4">
            <h6 class="text-muted text-uppercase fw-bold small mb-3">Tests Requested</h6>
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr class="text-muted small">
                        <th>TEST NAME</th>
                        <th>CATEGORY</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model!.Tests)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">@t.TestName</td>
                            <td class="text-muted">@t.Category</td>
                            <td><span class="badge @badgeClass rounded-pill px-3">@t.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Samples -->
    <div class="col-12">
        <div class="glass-card p-4">
            <h6 class="text-muted text-uppercase fw-bold small mb-3">Sample Barcodes</h6>
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr class="text-muted small">
                        <th>BARCODE</th>
                        <th>SAMPLE TYPE</th>
                        <th>RECEIVED</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var smp in Model.Samples)
                    {
                        <tr>
                            <td><span class="fw-bold">@smp.Barcode</span></td>
                            <td>@smp.SampleType <span class="text-muted small">(@smp.TestName)</span></td>
                            <td>
                                @if (smp.ReceivedOn.HasValue)
                                {
                                    <span class="small">@smp.ReceivedOn.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Awaiting receipt</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@if (Model != null && Model.CanCancel)
{
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <form asp-controller="Doctor" asp-action="CancelRequest" asp-route-id="@Model.TestRequestId" method="post">
                    <div class="modal-header bg-dark text-white px-4 py-3">
                        <h5 class="modal-title fs-6"><i class="bi bi-x-circle me-2"></i>Cancel request #REQ-@Model.TestRequestId.ToString("D3")</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <label class="form-label small text-muted fw-bold">Reason for cancelling (the patient is told)</label>
                        <textarea name="reason" rows="3" maxlength="500" required class="form-control"></textarea>
                    </div>
                    <div class="modal-footer px-4 py-3 bg-light rounded-bottom-3">
                        <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Keep request</button>
                        <button type="submit" class="btn btn-danger rounded-3 px-4">Cancel request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
