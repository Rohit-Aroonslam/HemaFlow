@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="container" style="padding-top:90px; padding-bottom:40px;">
    <div class="row justify-content-center">
        <div class="col-xl-11 col-xxl-10">
            <div class="auth-card" style="border:1px solid #e1e1e1; background:#fff;">
                <div class="row g-0">

                    @* Left info panel *@
                    <div class="col-lg-4 d-none d-lg-flex flex-column justify-content-between p-4" style="background:#0f172a; color:#fff;">
                        <div>
                            <h5 class="fw-bold mb-1">Hema Flow Portal</h5>
                            <p class="mb-4" style="font-size:0.8rem; color:rgba(255,255,255,0.45);">Sign in to access:</p>
                            <ul class="list-unstyled" style="font-size:0.85rem; color:rgba(255,255,255,0.65);">
                                <li class="mb-3 d-flex align-items-start gap-2"><i class="bi bi-check2 mt-1" style="color:#60a5fa;"></i> Your clinical dashboard or patient records</li>
                                <li class="mb-3 d-flex align-items-start gap-2"><i class="bi bi-check2 mt-1" style="color:#60a5fa;"></i> Real-time test request tracking</li>
                                <li class="mb-3 d-flex align-items-start gap-2"><i class="bi bi-check2 mt-1" style="color:#60a5fa;"></i> Secure communication with your clinic</li>
                                <li class="d-flex align-items-start gap-2"><i class="bi bi-check2 mt-1" style="color:#60a5fa;"></i> POPIA-compliant data storage</li>
                            </ul>
                        </div>
                        <p style="font-size:0.72rem; color:rgba(255,255,255,0.25);">Nelson Mandela Bay Haematology Diagnostic Laboratories</p>
                    </div>

                    @* Right form *@
                    <div class="col-lg-8 p-4 d-flex flex-column justify-content-center">
                        <h5 class="fw-bold mb-1">Portal Login</h5>
                        <p class="text-muted small mb-4">Access your clinical dashboard or patient records.</p>

                        @if (TempData["Success"] != null)
                        {
                            <div data-toast="success" class="alert alert-success rounded-0 border-0 border-start border-3 border-success small mb-3" role="alert">
                                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div data-toast="danger" class="alert alert-danger rounded-0 border-0 border-start border-3 border-danger small mb-3" role="alert">
                                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                            </div>
                        }

                        <form asp-controller="Account" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Email Address</label>
                                <input type="email" name="email" class="form-control" placeholder="name@example.com" autocomplete="username" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Password</label>
                                <div class="input-group">
                                    <input type="password" id="loginPassword" name="password" class="form-control" placeholder="••••••••" autocomplete="current-password" required>
                                    <button class="btn btn-outline-secondary" type="button" id="toggleLoginPwd">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" value="true">
                                    <label class="form-check-label small" for="rememberMe">Remember me</label>
                                </div>
                                <a asp-controller="Account" asp-action="ForgotPassword" class="small text-dark text-decoration-none">Forgot Password?</a>
                            </div>

                            <button type="submit" class="btn btn-dark w-100 fw-semibold py-2">Sign In to Hema Flow</button>
                        </form>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <p class="small text-muted mb-0">
                                Don't have an account?
                                <a class="fw-semibold text-dark" asp-controller="Account" asp-action="Register">Register</a>
                            </p>
                            <p class="small text-muted mb-0">Staff: contact your Admin for credentials.</p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('toggleLoginPwd').addEventListener('click', function () {
        const input = document.getElementById('loginPassword');
        const icon = this.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye-slash';
        }
    });
</script>
