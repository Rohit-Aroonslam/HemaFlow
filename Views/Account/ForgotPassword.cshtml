@model Project.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
    ViewData["PanelTitle"] = "Account Recovery";
    ViewData["PanelSub"] = "Locked out? Here is how it works:";
    ViewData["PanelItems"] = new[] { "Enter the email you registered with", "We email you a secure reset link", "Choose a new password and sign in", "The link expires, so use it soon" };
}

<div class="container" style="padding-top:90px; padding-bottom:40px;">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-xxl-8">
            <div class="auth-card" style="border:1px solid #e1e1e1; background:#fff;">
                <div class="row g-0">
                    <partial name="_AuthSidePanel" view-data="ViewData" />

                    <div class="col-lg-8 p-4 d-flex flex-column justify-content-center">
                        <h5 class="fw-bold mb-1">Forgot Password</h5>
                        <p class="text-muted small mb-4">Enter your email and we'll send you a link to reset your password.</p>

                        @if (TempData["Success"] != null)
                        {
                            <div data-toast="success" class="alert alert-success rounded-0 border-0 border-start border-3 border-success small mb-3" role="alert">
                                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div data-toast="danger" class="alert alert-danger rounded-0 border-0 border-start border-3 border-danger small mb-3" role="alert">
                                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                            </div>
                        }

                        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Email Address</label>
                                <input type="email" name="Email" class="form-control" placeholder="name@example.com" autocomplete="username" required>
                            </div>
                            <button type="submit" class="btn btn-dark w-100 fw-semibold">Send Reset Link</button>
                        </form>

                        <hr class="my-4">
                        <p class="small text-muted mb-0">
                            Remembered your password?
                            <a asp-controller="Account" asp-action="Login" class="text-dark fw-semibold text-decoration-none">Back to Login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
