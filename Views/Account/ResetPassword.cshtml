@model Project.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
    ViewData["PanelTitle"] = "Reset Password";
    ViewData["PanelSub"] = "Pick a strong password that:";
    ViewData["PanelItems"] = new[] { "Is at least 8 characters long", "Has an uppercase letter and a number", "Has one special character", "You do not use on other sites" };
}

<div class="container" style="padding-top:90px; padding-bottom:40px;">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-xxl-8">
            <div class="auth-card" style="border:1px solid #e1e1e1; background:#fff;">
                <div class="row g-0">
                    <partial name="_AuthSidePanel" view-data="ViewData" />

                    <div class="col-lg-8 p-4">
                        <h5 class="fw-bold mb-1">Choose a New Password</h5>
                        <p class="text-muted small mb-4">Choose a new password for your account.</p>

                        @if (TempData["Error"] != null)
                        {
                            <div data-toast="danger" class="alert alert-danger rounded-0 border-0 border-start border-3 border-danger small mb-3" role="alert">
                                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                            </div>
                        }

                        <form asp-controller="Account" asp-action="ResetPassword" method="post" id="resetPasswordForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Token" value="@Model.Token" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold">New Password</label>
                    <div class="input-group">
                        <input type="password" id="newPassword" name="NewPassword" class="form-control" placeholder="Min. 8 characters" required>
                        <button class="btn btn-outline-secondary" type="button" id="toggleNew"><i class="bi bi-eye-slash"></i></button>
                    </div>
                    <ul class="list-unstyled mt-2 mb-0" id="pwChecklist" style="font-size:0.72rem;">
                        <li class="d-flex align-items-center gap-2 mb-1" data-rule="length">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                            <span class="text-muted">At least 8 characters</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 mb-1" data-rule="upper">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                            <span class="text-muted">One uppercase letter</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 mb-1" data-rule="number">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                            <span class="text-muted">One number</span>
                        </li>
                        <li class="d-flex align-items-center gap-2" data-rule="special">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                            <span class="text-muted">One special character</span>
                        </li>
                    </ul>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Confirm New Password</label>
                    <div class="input-group">
                        <input type="password" id="confirmPassword" name="ConfirmPassword" class="form-control" placeholder="Re-enter new password" required>
                        <button class="btn btn-outline-secondary" type="button" id="toggleConfirm"><i class="bi bi-eye-slash"></i></button>
                    </div>
                </div>

                <button type="submit" class="btn btn-dark w-100 fw-semibold">Reset Password</button>
            </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePwd(btnId, inputId) {
        document.getElementById(btnId).addEventListener('click', function () {
            const input = document.getElementById(inputId);
            const icon = this.querySelector('i');
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.className = input.type === 'text' ? 'bi bi-eye' : 'bi bi-eye-slash';
        });
    }
    togglePwd('toggleNew', 'newPassword');
    togglePwd('toggleConfirm', 'confirmPassword');

    const pwInput = document.getElementById('newPassword');
    function updateChecklist(pw) {
        const rules = {
            length: pw.length >= 8, upper: /[A-Z]/.test(pw),
            number: /[0-9]/.test(pw), special: /[^A-Za-z0-9]/.test(pw)
        };
        Object.keys(rules).forEach(function (key) {
            const li = document.querySelector('#pwChecklist [data-rule="' + key + '"]');
            const icon = li.querySelector('i'), label = li.querySelector('span');
            if (rules[key]) { icon.className = 'bi bi-check-circle-fill text-success'; label.classList.replace('text-muted', 'text-success'); }
            else { icon.className = 'bi bi-x-circle-fill text-danger'; label.classList.replace('text-success', 'text-muted'); }
        });
    }
    pwInput.addEventListener('input', function () { updateChecklist(this.value); });

    document.getElementById('resetPasswordForm').addEventListener('submit', function (e) {
        const pw = pwInput.value;
        const cp = document.getElementById('confirmPassword').value;
        let valid = pw.length >= 8 && /[A-Z]/.test(pw) && /[0-9]/.test(pw) && /[^A-Za-z0-9]/.test(pw) && pw === cp;
        if (!valid) e.preventDefault();
    });
</script>
