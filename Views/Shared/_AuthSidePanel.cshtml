@* Dark info panel used on the auth pages. ViewData: PanelTitle, PanelSub, PanelItems (string[]) *@
@{
    var items = ViewData["PanelItems"] as string[] ?? new string[0];
}
<div class="col-lg-4 d-none d-lg-flex flex-column justify-content-between p-4" style="background:#0f172a; color:#fff;">
    <div>
        <h5 class="fw-bold mb-1">@ViewData["PanelTitle"]</h5>
        <p class="mb-4" style="font-size:0.8rem; color:rgba(255,255,255,0.45);">@ViewData["PanelSub"]</p>
        <ul class="list-unstyled mb-0" style="font-size:0.85rem; color:rgba(255,255,255,0.65);">
            @for (var i = 0; i < items.Length; i++)
            {
                <li class="@(i < items.Length - 1 ? "mb-3 " : "")d-flex align-items-start gap-2"><i class="bi bi-check2 mt-1" style="color:#60a5fa;"></i> @items[i]</li>
            }
        </ul>
    </div>
    <p class="mb-0" style="font-size:0.72rem; color:rgba(255,255,255,0.25);">Nelson Mandela Bay Haematology Diagnostic Laboratories</p>
</div>
