@model Project.Models.TwoFactorSetupViewModel
@{
    Layout = "_PatientLayout";
    ViewData["Title"] = "Set Up Two-Factor Authentication | Hema Flow";
}

<div class="row align-items-center mb-4 g-3">
    <div class="col-md-8">
        <button type="button" onclick="history.back()" class="btn btn-link text-muted p-0 mb-2 text-decoration-none" style="font-size: 0.82rem;">
            <i class="bi bi-arrow-left me-1"></i>Back
        </button>
        <h4 class="fw-700 mb-1" style="color: #0f172a;">Set Up Two-Factor Authentication</h4>
        <p class="text-muted small mb-0">Use an authenticator app like Google Authenticator or Microsoft Authenticator.</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div data-toast="danger" class="alert alert-danger rounded-0 border-0 border-start border-3 border-danger small mb-4" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
    </div>
}

<div class="card mb-4" style="max-width: 620px;">
    <div class="card-header">
        <i class="bi bi-qr-code text-primary me-2"></i>Step 1 - Scan This QR Code
    </div>
    <div class="p-4 text-center">
        <div id="qrCodeContainer" class="d-flex justify-content-center mb-3"></div>
        <p class="text-muted small mb-2">Can't scan it? Enter this key manually in your authenticator app:</p>
        <div class="d-inline-block px-3 py-2 bg-light border" style="font-family:'Courier New',monospace; font-size:0.95rem; letter-spacing:0.08em;">
            @Model.SecretKey
        </div>
    </div>
</div>

<div class="card mb-4" style="max-width: 620px;">
    <div class="card-header">
        <i class="bi bi-shield-check text-primary me-2"></i>Step 2 - Enter The Code From Your App
    </div>
    <div class="p-4">
        <form asp-action="Setup2FAConfirm" asp-controller="Patient" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label small fw-semibold">6-Digit Code</label>
                <input type="text" name="code" class="form-control" placeholder="123456" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required>
            </div>
            <div class="col-md-6">
                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-check-lg me-1"></i>Confirm &amp; Enable 2FA
                </button>
            </div>
        </form>
        <p class="text-muted x-small mt-3 mb-0">
            The code refreshes every 30 seconds - if it doesn't match, wait for the next one and try again.
        </p>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qrCodeContainer"), {
            text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OtpAuthUri)),
            width: 200,
            height: 200
        });
    </script>
}
