@model Project.Models.AccountChangePasswordViewModel
@{
    Layout = "_PatientLayout";
    ViewData["Title"] = "Change Password | Hema Flow";
}

<div class="row align-items-center mb-4 g-3">
    <div class="col-md-8">
        <button type="button" onclick="history.back()" class="btn btn-link text-muted p-0 mb-2 text-decoration-none" style="font-size: 0.82rem;">
            <i class="bi bi-arrow-left me-1"></i>Back
        </button>
        <h4 class="fw-700 mb-1" style="color: #0f172a;">Change Password</h4>
        <p class="text-muted small mb-0">Update the password you use to sign in.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div data-toast="success" class="alert alert-success rounded-0 border-0 border-start border-3 border-success small mb-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div data-toast="danger" class="alert alert-danger rounded-0 border-0 border-start border-3 border-danger small mb-4" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
    </div>
}

<div class="card mb-4" style="max-width: 520px;">
    <div class="card-header">
        <i class="bi bi-key text-primary me-2"></i>Update Password
    </div>
    <div class="p-4">
        <form id="changePasswordForm" asp-controller="Patient" asp-action="ChangePassword" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label small fw-semibold">Current Password <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input type="password" id="currentPassword" name="CurrentPassword" class="form-control" placeholder="Enter current password" required>
                    <button class="btn btn-outline-secondary" type="button" id="toggleCurrent"><i class="bi bi-eye-slash"></i></button>
                </div>
                <div class="invalid-feedback">Current password is required.</div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">New Password <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input type="password" id="newPassword" name="NewPassword" class="form-control" placeholder="Min. 8 characters" required>
                    <button class="btn btn-outline-secondary" type="button" id="toggleNew"><i class="bi bi-eye-slash"></i></button>
                </div>
                <div id="pwFeedback" class="invalid-feedback d-block" style="display:none !important;"></div>
                <ul class="list-unstyled mt-2 mb-0" id="pwChecklist" style="font-size:0.72rem;">
                    <li class="d-flex align-items-center gap-2 mb-1" data-rule="length">
                        <i class="bi bi-x-circle-fill text-danger"></i>
                        <span class="text-muted">At least 8 characters</span>
                    </li>
                    <li class="d-flex align-items-center gap-2 mb-1" data-rule="upper">
                        <i class="bi bi-x-circle-fill text-danger"></i>
                        <span class="text-muted">One uppercase letter</span>
                    </li>
                    <li class="d-flex align-items-center gap-2 mb-1" data-rule="number">
                        <i class="bi bi-x-circle-fill text-danger"></i>
                        <span class="text-muted">One number</span>
                    </li>
                    <li class="d-flex align-items-center gap-2" data-rule="special">
                        <i class="bi bi-x-circle-fill text-danger"></i>
                        <span class="text-muted">One special character (e.g. !@@#$%)</span>
                    </li>
                </ul>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold">Confirm New Password <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input type="password" id="confirmNewPassword" name="ConfirmPassword" class="form-control" placeholder="Re-enter new password" required>
                    <button class="btn btn-outline-secondary" type="button" id="toggleConfirm"><i class="bi bi-eye-slash"></i></button>
                </div>
                <div class="invalid-feedback" id="confirmFeedback">Passwords do not match.</div>
                <ul class="list-unstyled mt-1 mb-0" id="matchIndicator" style="font-size:0.72rem; display:none;">
                    <li class="d-flex align-items-center gap-2" id="matchIndicatorItem">
                        <i class="bi bi-x-circle-fill text-danger"></i>
                        <span class="text-muted">Passwords match</span>
                    </li>
                </ul>
            </div>

            <button type="submit" class="btn btn-dark w-100 fw-semibold">Update Password</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function togglePwd(btnId, inputId) {
                document.getElementById(btnId).addEventListener('click', function () {
                    const input = document.getElementById(inputId);
                    const icon = this.querySelector('i');
                    input.type = input.type === 'password' ? 'text' : 'password';
                    icon.className = input.type === 'text' ? 'bi bi-eye' : 'bi bi-eye-slash';
                });
            }
            togglePwd('toggleCurrent', 'currentPassword');
            togglePwd('toggleNew', 'newPassword');
            togglePwd('toggleConfirm', 'confirmNewPassword');

            const pwInput = document.getElementById('newPassword');

            function updatePasswordChecklist(pw) {
                const rules = {
                    length: pw.length >= 8,
                    upper: /[A-Z]/.test(pw),
                    number: /[0-9]/.test(pw),
                    special: /[^A-Za-z0-9]/.test(pw)
                };
                Object.keys(rules).forEach(function (key) {
                    const li = document.querySelector('#pwChecklist [data-rule="' + key + '"]');
                    if (!li) return;
                    const icon = li.querySelector('i');
                    const label = li.querySelector('span');
                    if (rules[key]) {
                        icon.className = 'bi bi-check-circle-fill text-success';
                        label.classList.remove('text-muted');
                        label.classList.add('text-success');
                    } else {
                        icon.className = 'bi bi-x-circle-fill text-danger';
                        label.classList.remove('text-success');
                        label.classList.add('text-muted');
                    }
                });
            }

            const confirmInput = document.getElementById('confirmNewPassword');
            const matchIndicator = document.getElementById('matchIndicator');

            function checkMatch() {
                const pw = pwInput.value;
                const cp = confirmInput.value;
                const icon = document.querySelector('#matchIndicatorItem i');
                const label = document.querySelector('#matchIndicatorItem span');
                if (!cp) { matchIndicator.style.display = 'none'; return; }
                matchIndicator.style.display = 'block';
                if (pw === cp) {
                    icon.className = 'bi bi-check-circle-fill text-success';
                    label.classList.remove('text-muted');
                    label.classList.add('text-success');
                    confirmInput.classList.remove('is-invalid');
                    confirmInput.classList.add('is-valid');
                } else {
                    icon.className = 'bi bi-x-circle-fill text-danger';
                    label.classList.remove('text-success');
                    label.classList.add('text-muted');
                    confirmInput.classList.add('is-invalid');
                    confirmInput.classList.remove('is-valid');
                }
            }

            pwInput.addEventListener('input', function () {
                updatePasswordChecklist(this.value);
                checkMatch();
            });
            confirmInput.addEventListener('input', checkMatch);

            document.getElementById('changePasswordForm').addEventListener('submit', function (e) {
                let valid = true;

                if (!document.getElementById('currentPassword').value.trim()) {
                    document.getElementById('currentPassword').classList.add('is-invalid');
                    valid = false;
                } else {
                    document.getElementById('currentPassword').classList.remove('is-invalid');
                }

                const pw = pwInput.value;
                if (pw.length < 8 || !/[A-Z]/.test(pw) || !/[0-9]/.test(pw) || !/[^A-Za-z0-9]/.test(pw)) {
                    pwInput.classList.add('is-invalid');
                    document.getElementById('pwFeedback').textContent = 'Password must be 8+ characters with uppercase, number, and special character.';
                    document.getElementById('pwFeedback').style.display = 'block';
                    valid = false;
                } else {
                    pwInput.classList.remove('is-invalid');
                    document.getElementById('pwFeedback').style.display = 'none';
                }

                if (pw !== confirmInput.value) {
                    confirmInput.classList.add('is-invalid');
                    valid = false;
                }

                if (!valid) {
                    e.preventDefault();
                    // Same toast as the rest of the site, so the problem is obvious
                    var msg = !document.getElementById('currentPassword').value.trim()
                        ? 'Enter your current password.'
                        : (pw.length < 8 || !/[A-Z]/.test(pw) || !/[0-9]/.test(pw) || !/[^A-Za-z0-9]/.test(pw))
                            ? 'The new password needs 8 or more characters with a capital letter, a number and a special character.'
                            : 'The new password and the confirmation do not match.';
                    if (window.HemaUI) HemaUI.toast({ message: msg, type: 'danger' });
                    var firstBad = document.querySelector('#changePasswordForm .is-invalid');
                    if (firstBad) firstBad.focus();
                }
            });
        })();
    </script>
}
