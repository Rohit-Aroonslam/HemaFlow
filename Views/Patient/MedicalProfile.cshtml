@* JSON data for patient-side pickers - sourced from the real, admin-managed master lists *@
<script>
    var hfAllergies = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AvailableAllergies.Select(a => new { name = a.Name, category = a.Category })));
    var hfMedications = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AvailableMedications.Select(m => new { name = m.Name, category = m.Category })));
    var hfConditions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AvailableConditions.Select(c => new { name = c.Name, category = c.Category })));
    var newBackupCodesRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["NewBackupCodes"] as string ?? ""));
</script>

@section Scripts {
    <script>
        // ── Show newly generated backup codes exactly once, right after they're created ──
        document.addEventListener('DOMContentLoaded', function () {
            if (!newBackupCodesRaw) return;
            var codes = newBackupCodesRaw.split(',').filter(Boolean);
            if (!codes.length) return;

            var list = document.getElementById('newBackupCodesList');
            codes.forEach(function (code) {
                var col = document.createElement('div');
                col.className = 'col-6 col-md-4';
                col.innerHTML = '<div style="font-family:\'Courier New\',monospace; font-size:0.88rem; font-weight:700;' +
                    'background:#f8fafc; border:1px solid #e2e8f0; padding:0.55rem 0.75rem;' +
                    'text-align:center; letter-spacing:0.08em;">' + code + '</div>';
                list.appendChild(col);
            });

            document.getElementById('copyNewBackupCodesBtn').addEventListener('click', function () {
                navigator.clipboard.writeText(codes.join('\n')).then(function () {
                    var btn = document.getElementById('copyNewBackupCodesBtn');
                    btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Copied';
                    setTimeout(function () { btn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy All'; }, 2000);
                });
            });

            new bootstrap.Modal(document.getElementById('newBackupCodesModal')).show();
        });

        document.addEventListener('DOMContentLoaded', function () {

            // ── Doctor search ──────────────────────────────────────────────────────────
            const searchInput   = document.getElementById('doctorSearchInput');
            const resultsBox    = document.getElementById('doctorSearchResults');
            const confirmForm   = document.getElementById('confirmDoctorForm');
            const selectedHpcsa = document.getElementById('selectedHpcsa');
            const previewName   = document.getElementById('previewName');
            const previewDetails= document.getElementById('previewDetails');

            let searchTimer = null;
            function esc(t) { const d = document.createElement('div'); d.textContent = t || ''; return d.innerHTML; }

            // Asks the server for doctors matching the box and draws a card for each.
            function runSearch() {
                const q = searchInput.value.trim();
                fetch('@Url.Action("SearchDoctors", "Patient")?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
                    .then(r => r.json())
                    .then(function (matches) {
                        resultsBox.innerHTML = '';
                        confirmForm.style.display = 'none';
                        if (!matches.length) {
                            resultsBox.innerHTML = '<p class="text-muted x-small mb-0">No doctors found. Try a different name or HPCSA number.</p>';
                            return;
                        }
                        matches.forEach(function (doc) {
                            const card = document.createElement('div');
                            card.className = 'p-2 border bg-light d-flex justify-content-between align-items-center';
                            card.style.cursor = 'pointer';
                            card.innerHTML =
                                '<div>' +
                                    '<div class="fw-600 text-dark small">' + esc(doc.name) + '</div>' +
                                    '<div class="text-muted x-small">' + esc(doc.specialty || 'General') + '</div>' +
                                    '<div class="text-muted x-small">HPCSA: ' + esc(doc.hpcsaNumber) + '</div>' +
                                '</div>' +
                                '<i class="bi bi-chevron-right text-muted small"></i>';
                            card.addEventListener('click', function () {
                                selectedHpcsa.value = doc.hpcsaNumber;
                                previewName.textContent = doc.name;
                                previewDetails.textContent = (doc.specialty || 'General') + ' (HPCSA: ' + doc.hpcsaNumber + ')';
                                confirmForm.style.display = 'block';
                                resultsBox.innerHTML = '';
                                searchInput.value = doc.name;
                            });
                            resultsBox.appendChild(card);
                        });
                    })
                    .catch(function () {
                        resultsBox.innerHTML = '<p class="text-danger x-small mb-0">Could not load doctors. Please try again.</p>';
                    });
            }

            // Results update as you type (short delay so we do not call the server on every key).
            searchInput.addEventListener('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(runSearch, 200);
            });
            // Show the full list as soon as the box opens.
            document.getElementById('changeDoctorModal').addEventListener('shown.bs.modal', runSearch);

            document.getElementById('changeDoctorModal').addEventListener('hidden.bs.modal', function () {
                searchInput.value = '';
                resultsBox.innerHTML = '';
                confirmForm.style.display = 'none';
            });
        });

        // ── Setup the three real-data pickers ──────────────────────────────
        setupPicker({
            searchId: 'allergyNameSearch', dropId: 'allergyDropdown', catFilterId: 'allergyCategoryFilter',
            hiddenNameId: 'allergyName', hiddenOtherId: 'allergyIsOther',
            catDisplayId: 'allergyCategoryDisplay', otherNoticeId: 'allergyOtherNotice',
            submitBtnId: 'allergySubmitBtn', data: hfAllergies
        });
        setupPicker({
            searchId: 'medNameSearch', dropId: 'medDropdown', catFilterId: 'medCategoryFilter',
            hiddenNameId: 'medName', hiddenOtherId: 'medIsOther',
            catDisplayId: 'medCategoryDisplay', otherNoticeId: 'medOtherNotice',
            submitBtnId: 'medSubmitBtn', data: hfMedications
        });
        setupPicker({
            searchId: 'conditionNameSearch', dropId: 'conditionDropdown', catFilterId: 'conditionCategoryFilter',
            hiddenNameId: 'conditionName', hiddenOtherId: 'conditionIsOther',
            catDisplayId: 'conditionCategoryDisplay', otherNoticeId: 'conditionOtherNotice',
            submitBtnId: 'conditionSubmitBtn', data: hfConditions
        });

        function setupPicker(opts) {
            const search      = document.getElementById(opts.searchId);
            const drop        = document.getElementById(opts.dropId);
            const catFilter   = document.getElementById(opts.catFilterId);
            const hiddenName  = document.getElementById(opts.hiddenNameId);
            const hiddenOther = document.getElementById(opts.hiddenOtherId);
            const catDisplay  = document.getElementById(opts.catDisplayId);
            const otherNotice = document.getElementById(opts.otherNoticeId);
            const submitBtn   = document.getElementById(opts.submitBtnId);
            if (!search || !drop) return;

            function clearSelection() {
                hiddenName.value = '';
                hiddenOther.value = 'false';
                catDisplay.value = '';
                catDisplay.placeholder = 'Select a name above first';
                otherNotice.style.display = 'none';
                submitBtn.disabled = true;
            }

            function selectReal(item) {
                hiddenName.value = item.name;
                hiddenOther.value = 'false';
                search.value = item.name;
                catDisplay.value = item.category;
                otherNotice.style.display = 'none';
                submitBtn.disabled = false;
                drop.style.display = 'none';
            }

            function selectOther(name) {
                hiddenName.value = name;
                hiddenOther.value = 'true';
                catDisplay.value = '';
                catDisplay.placeholder = 'Will be assigned by admin on approval';
                otherNotice.style.display = 'block';
                submitBtn.disabled = false;
                drop.style.display = 'none';
            }

            search.addEventListener('input', function () {
                clearSelection();
                const q = this.value.trim().toLowerCase();
                const catVal = catFilter ? catFilter.value : '';
                drop.innerHTML = '';

                if (q.length < 1) { drop.style.display = 'none'; return; }

                const matches = opts.data.filter(function (d) {
                    return d.name.toLowerCase().includes(q) && (!catVal || d.category === catVal);
                });

                matches.slice(0, 8).forEach(function (item) {
                    const el = document.createElement('div');
                    el.className = 'px-3 py-2 border-bottom';
                    el.style.cssText = 'cursor:pointer;font-size:0.82rem;';
                    el.innerHTML = '<div class="fw-600 text-dark">' + item.name + '</div>' +
                        '<div class="text-muted" style="font-size:0.7rem;">' + item.category + '</div>';
                    el.addEventListener('mouseenter', function () { this.style.background = '#f8fafc'; });
                    el.addEventListener('mouseleave', function () { this.style.background = ''; });
                    el.addEventListener('click', function () { selectReal(item); });
                    drop.appendChild(el);
                });

                // "Other" fallback - always offered so the patient isn't stuck if their
                // exact term isn't on the list yet.
                const otherEl = document.createElement('div');
                otherEl.className = 'px-3 py-2 bg-light';
                otherEl.style.cssText = 'cursor:pointer;font-size:0.8rem;';
                otherEl.innerHTML = '<i class="bi bi-plus-circle me-1 text-primary"></i>Add "' +
                    this.value.trim() + '" as Other <span class="text-muted">(needs admin approval)</span>';
                otherEl.addEventListener('mouseenter', function () { this.style.background = '#f1f5f9'; });
                otherEl.addEventListener('mouseleave', function () { this.style.background = '#f8fafc'; });
                otherEl.addEventListener('click', function () { selectOther(search.value.trim()); });
                drop.appendChild(otherEl);

                drop.style.display = 'block';
            });

            if (catFilter) {
                catFilter.addEventListener('change', function () {
                    clearSelection();
                    search.value = '';
                    drop.style.display = 'none';
                });
            }

            document.addEventListener('click', function (e) {
                if (!search.contains(e.target) && !drop.contains(e.target))
                    drop.style.display = 'none';
            });

            clearSelection();
        }
    </script>
}
