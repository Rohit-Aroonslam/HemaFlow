@model Project.Models.PatientDashboardViewModel
@{
    Layout = "_PatientLayout";
    ViewData["Title"] = "Dashboard | Hema Flow";

    // Helper: map status string to a Bootstrap colour token
    string StatusColor(string s) => s switch
    {
        "Released by Doctor" => "success",
        "Completed" => "success",
        "In Progress" => "warning",
        "Samples Received" => "info",
        "Submitted" => "secondary",
        "Cancelled" => "danger",
        _ => "secondary"
    };

    string StatusIcon(string s) => s switch
    {
        "Released by Doctor" => "bi-check-circle",
        "Completed" => "bi-check-circle",
        "In Progress" => "bi-clock-history",
        "Samples Received" => "bi-droplet",
        "Submitted" => "bi-send",
        "Cancelled" => "bi-x-circle",
        _ => "bi-circle"
    };
}

<div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
    <div>
        <p class="text-muted small text-uppercase fw-bold mb-1" style="letter-spacing:2px;" id="greetingLabel">Welcome back</p>
        <h2 class="serif-brand mb-0">@Model.PatientName</h2>
        <p class="text-muted small mb-0">
            You have
            <span class="fw-600 text-dark">@Model.ActiveRequestCount active test request@(Model.ActiveRequestCount == 1 ? "" : "s")</span>
            currently in the lab.
        </p>
        <div class="dash-chrome-strip">
            <span class="dash-chrome-item"><i class="bi bi-clock-fill"></i><span id="liveClock">--:--:--</span></span>
            <span class="dash-chrome-sep">&middot;</span>
            <span class="dash-chrome-item"><i class="bi bi-cloud-sun-fill"></i><span id="weatherText">Loading weather&hellip;</span></span>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div data-toast="success" class="alert alert-success rounded-0 border-0 border-start border-3 border-success small mb-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
    </div>
}

<div class="row g-4">
    <div class="col-lg-8 d-flex flex-column gap-4">

        <div class="dash-section accent-blue">
            <div class="dash-section-header section-toggle" data-bs-toggle="collapse" data-bs-target="#recentTestsCollapse" aria-expanded="true">
                <div class="dash-section-title d-flex align-items-center gap-2">
                    <i class="bi bi-activity text-primary"></i>
                    <span>Recent Test Requests</span>
                </div>
                <div class="dash-section-meta d-flex align-items-center gap-2">
                    <a asp-controller="Patient" asp-action="TrackResults" class="small text-decoration-none text-primary fw-600">View History</a>
                    <i class="bi bi-chevron-down dash-chevron"></i>
                </div>
            </div>
            <div class="collapse show" id="recentTestsCollapse">
                <div class="p-3">
                    @if (!Model.RecentRequests.Any())
                    {
                        <p class="text-muted small mb-0">No recent test requests found.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Test Type</th>
                                        <th>Requested On</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in Model.RecentRequests)
                                    {
                                        var color = StatusColor(req.Status);
                                        var icon = StatusIcon(req.Status);
                                        var canDownload = req.Status == "Released by Doctor";
                                        <tr>
                                            <td><span class="fw-600">@req.TestName</span></td>
                                            <td>@req.RequestDate.ToString("d MMM yyyy")</td>
                                            <td>
                                                <span class="patient-status-pill text-@color border-@color">
                                                    <i class="bi @icon me-1"></i>@req.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                @if (canDownload)
                                                {
                                                    <a asp-controller="Patient" asp-action="RequestResults" asp-route-id="@req.RequestId" class="btn btn-sm btn-outline-dark px-3 me-1">
                                                        <i class="bi bi-eye me-1"></i>View
                                                    </a>
                                                    <a asp-controller="Patient" asp-action="DownloadResult" asp-route-id="@req.RequestId" class="btn btn-sm btn-dark px-3">
                                                        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-light px-3" disabled>@(req.Status == "Completed" ? "Awaiting doctor release" : "Pending")</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-card-header ch-blue justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Trend Overview</span>
                </div>
                <a asp-controller="Patient" asp-action="TrackResults" class="small text-decoration-none fw-600">View All Trends</a>
            </div>
            <div class="chart-card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    @if (Model.TrackedTest != "")
                    {
                        <p class="text-muted mb-0" style="font-size: 0.78rem;">Tracking @Model.TrackedTest (@Model.TrackedTestUnit) across your released results</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0" style="font-size: 0.78rem;">Your results will be charted here once a doctor releases them.</p>
                    }
                    @if (Model.AvailableTrackedTests.Any())
                    {
                    <select id="dashboardTestPicker" class="form-select form-select-sm bg-light border-0 rounded-0" style="width:auto; min-width:11rem; max-width:16rem; font-size:0.78rem; padding-right:2.25rem; text-overflow:ellipsis;">
                        @foreach (var t in Model.AvailableTrackedTests)
                        {
                            <option value="@t" selected="@(t == Model.TrackedTest ? "selected" : null)">@t</option>
                        }
                    </select>
                    }
                </div>
                @if (Model.TrackedTest == "")
                {
                    <div class="text-center text-muted small py-5"><i class="bi bi-graph-up fs-3 d-block mb-2"></i>No results to chart yet.</div>
                }
                else
                {
                <div style="height: 250px; width: 100%;">
                    <canvas id="dashboardTrendChart"></canvas>
                </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4 d-flex flex-column gap-4">

        <div class="card">
            <div class="card-header ch-slate">
                <i class="bi bi-lightning-charge-fill me-2"></i>Quick Actions
            </div>
            <div class="p-3 d-flex flex-column gap-2">
                <a asp-controller="Patient" asp-action="ConsentManagement" class="btn btn-outline-secondary text-start d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock text-primary fs-5"></i>
                        <div class="text-start">
                            <div class="fw-600 text-dark" style="font-size: 0.82rem; line-height: 1.2;">Manage Doctor Access</div>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">Grant or revoke doctor viewing rights</small>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
                <a asp-controller="Patient" asp-action="Reports" class="btn btn-outline-secondary text-start d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-pdf text-danger fs-5"></i>
                        <div class="text-start">
                            <div class="fw-600 text-dark" style="font-size: 0.82rem; line-height: 1.2;">Download Reports</div>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">Generate date-range PDF reports</small>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header ch-slate justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-lines-fill"></i> Health Profile Summary
                </div>
                <a asp-controller="Patient" asp-action="MedicalProfile" class="small text-decoration-none"><i class="bi bi-pencil-square"></i></a>
            </div>
            <div class="p-3">
                <div class="mb-3 pb-3 border-bottom" style="border-bottom-style: dashed !important;">
                    <small class="text-uppercase text-muted fw-600 d-block mb-2" style="font-size: 0.68rem; letter-spacing: 0.05em;">Chronic Conditions</small>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var c in Model.Conditions)
                        {
                            <span class="patient-status-pill text-primary border-primary bg-light">@c</span>
                        }
                        @if (!Model.Conditions.Any())
                        {
                            <span class="text-muted x-small">None recorded</span>
                        }
                    </div>
                </div>
                <div class="mb-3 pb-3 border-bottom" style="border-bottom-style: dashed !important;">
                    <small class="text-uppercase text-muted fw-600 d-block mb-2" style="font-size: 0.68rem; letter-spacing: 0.05em;">Allergies</small>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var a in Model.Allergies)
                        {
                            <span class="patient-status-pill text-danger border-danger" style="background: rgba(220,38,38,0.02)">@a</span>
                        }
                        @if (!Model.Allergies.Any())
                        {
                            <span class="text-muted x-small">None recorded</span>
                        }
                    </div>
                </div>
                <div>
                    <small class="text-uppercase text-muted fw-600 d-block mb-2" style="font-size: 0.68rem; letter-spacing: 0.05em;">Current Medication</small>
                    @foreach (var m in Model.Medications)
                    {
                        <div class="p-2 border-start border-3 border-info" style="background: #f8fafc;">
                            <div class="fw-600 text-dark" style="font-size: 0.8rem;">@m.Name</div>
                            <div class="text-muted" style="font-size: 0.72rem;">@string.Join(" • ", new[] { m.Form, m.Dosage, m.Frequency }.Where(t => !string.IsNullOrWhiteSpace(t)))</div>
                        </div>
                    }
                    @if (!Model.Medications.Any())
                    {
                        <span class="text-muted x-small">None recorded</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ── Header chrome: clock + weather, kept out of the data cards ── */
    .dash-chrome-strip {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }

    .dash-chrome-item {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.78rem;
        font-weight: 500;
        color: #64748b;
    }

        .dash-chrome-item i {
            color: #3b82f6;
            font-size: 0.85rem;
        }

    .dash-chrome-sep {
        color: #cbd5e1;
    }
</style>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Header chrome - live clock, time-aware greeting, weather (Gqeberha)
            var clockEl = document.getElementById('liveClock');
            function tick() {
                if (!clockEl) return;
                clockEl.textContent = new Date().toLocaleTimeString('en-ZA', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }
            tick();
            setInterval(tick, 1000);

            var greetEl = document.getElementById('greetingLabel');
            if (greetEl) {
                var h = new Date().getHours();
                greetEl.textContent = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
            }

            var weatherEl = document.getElementById('weatherText');
            if (weatherEl) {
                fetch('https://api.open-meteo.com/v1/forecast?latitude=-33.9608&longitude=25.6022&current=temperature_2m,weather_code,wind_speed_10m&wind_speed_unit=kmh&timezone=Africa%2FJohannesburg')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        var c = data && data.current;
                        if (!c) { weatherEl.textContent = 'Weather unavailable'; return; }
                        var codeMap = {
                            0: 'Clear sky', 1: 'Mostly clear', 2: 'Partly cloudy', 3: 'Overcast',
                            45: 'Fog', 48: 'Fog', 51: 'Drizzle', 53: 'Drizzle', 55: 'Drizzle',
                            61: 'Light rain', 63: 'Rain', 65: 'Heavy rain', 71: 'Snow', 80: 'Showers',
                            81: 'Showers', 82: 'Heavy showers', 95: 'Thunderstorm'
                        };
                        var desc = codeMap[c.weather_code] || 'Gqeberha';
                        weatherEl.textContent = Math.round(c.temperature_2m) + '°C · ' + desc;
                    })
                    .catch(function () { weatherEl.textContent = 'Weather unavailable'; });
            }

            // Dashboard trend chart - real data, patient-selectable test (item #7)
            const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrackedTestDataPoints.Select(d => d.Label)));
            const trendValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrackedTestDataPoints.Select(d => (double)d.Value)));
            const trendLabel = '@Model.TrackedTest (@Model.TrackedTestUnit)';

            const trendCanvas = document.getElementById('dashboardTrendChart');
            if (trendCanvas) {
            const ctx = trendCanvas.getContext('2d');
            const grad = ctx.createLinearGradient(0, 0, 0, 230);
            grad.addColorStop(0, 'rgba(59,130,246,0.12)');
            grad.addColorStop(1, 'rgba(59,130,246,0.00)');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [{ label: trendLabel, data: trendValues, borderColor: '#3b82f6', borderWidth: 2.5, backgroundColor: grad, fill: true, tension: 0.35, pointRadius: 4, pointBackgroundColor: '#fff', pointBorderColor: '#3b82f6', pointBorderWidth: 2 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: false, grid: { color: '#e2e8f0' }, ticks: { color: '#94a3b8' } }, x: { grid: { display: false }, ticks: { color: '#94a3b8' } } } }
            });

            }
            var picker = document.getElementById('dashboardTestPicker');
            if (picker) picker.addEventListener('change', function () {
                window.location.href = '@Url.Action("Index", "Patient")' + '?trackedTest=' + encodeURIComponent(this.value);
            });
        });
    </script>
}
