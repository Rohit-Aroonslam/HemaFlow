@model Project.Models.LabManager.SampleType
@{
    ViewData["Title"] = "Add Sample Type";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Add Sample Type</h2>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card shadow-sm border-0" style="max-width:480px">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Whole Blood" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>