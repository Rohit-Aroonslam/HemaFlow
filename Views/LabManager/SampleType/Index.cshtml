@model List<Project.Models.LabManager.SampleType>
@{
    ViewData["Title"] = "Sample Types";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Sample Types</h2>
    <div class="d-flex gap-2">
        <a asp-action="Archived" class="btn btn-outline-secondary"><i class="bi bi-archive me-1"></i>View Archived</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Sample Type</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Name</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var s in Model)
                    {
                        <tr>
                            <td class="ps-4"><strong>@s.Name</strong></td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-warning btn-sm me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Archive" asp-route-id="@s.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return hemaConfirm(this, 'Archive @s.Name?', { title: 'Archive Sample Type', confirmText: 'Archive' })">
                                    <i class="bi bi-archive"></i> Archive
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="2" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>No sample types found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>