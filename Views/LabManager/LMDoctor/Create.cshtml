@model Project.Models.LabManager.Doctor
@{
    ViewData["Title"] = "Add Doctor";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Add Doctor</h2>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card shadow-sm border-0" style="max-width:560px">
    <div class="card-body p-4">
        <div class="alert alert-info border-0 bg-info bg-opacity-10 mb-4">
            <i class="bi bi-info-circle me-2"></i>
            A temporary password will be auto-generated and emailed to the doctor on creation.
            They must change it on first login.
        </div>
        <form asp-action="Create" method="post">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="First name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Surname <span class="text-danger">*</span></label>
                    <input asp-for="Surname" class="form-control" placeholder="Last name" />
                    <span asp-validation-for="Surname" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">HPCSA Number <span class="text-danger">*</span></label>
                <input asp-for="HPCSANumber" class="form-control" placeholder="e.g. MP1234567" />
                <span asp-validation-for="HPCSANumber" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Email Address (Username) <span class="text-danger">*</span></label>
                <input asp-for="Email" class="form-control" type="email" placeholder="doctor@hospital.co.za" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Contact Number <span class="text-danger">*</span></label>
                <input asp-for="ContactNumber" class="form-control" placeholder="e.g. 0821234567" />
                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success"><i class="bi bi-person-plus me-1"></i>Create Doctor</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>