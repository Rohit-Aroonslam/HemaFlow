@model IEnumerable<Project.Models.LabManager.Doctor>
@{
    ViewData["Title"] = "Archived Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Archived Doctors</h2>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Doctors</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Surname</th>
                    <th>HPCSA No.</th>
                    <th>Email</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var d in Model)
                    {
                        <tr class="table-secondary">
                            <td class="ps-4"><strong>@d.Name</strong></td>
                            <td>@d.Surname</td>
                            <td><code>@d.HPCSANumber</code></td>
                            <td>@d.Email</td>
                            <td class="text-end pe-4">
                                <a asp-action="Unarchive" asp-route-id="@d.Id" class="btn btn-success btn-sm">
                                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No archived doctors.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>