@model Project.Models.LabManager.Order
@{
    ViewData["Title"] = "Order Details";
}

<!-- Order header -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h3 class="mb-1">Order @Model.OrderNumber</h3>
                <p class="text-muted mb-0">Supplier: <strong>@Model.Supplier?.Name</strong></p>
            </div>
            @{
                string badge = Model.Status == "Complete" ? "success" : Model.Status == "Partial" ? "warning" : Model.Status == "Cancelled" ? "danger" : "info";
            }
            <span class="badge bg-@badge fs-6">@Model.Status</span>
        </div>
        <hr />
        <div class="row g-3">
            <div class="col-md-3">
                <small class="text-muted d-block">Order Date</small>
                <strong>@Model.OrderDate.ToString("yyyy-MM-dd")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">Date Completed</small>
                <strong>@(Model.DateCompleted?.ToString("yyyy-MM-dd") ?? "-")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">Date Cancelled</small>
                <strong>@(Model.DateCancelled?.ToString("yyyy-MM-dd") ?? "-")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">Cancellation Reason</small>
                <strong>@(Model.CancellationReason ?? "-")</strong>
            </div>
        </div>

        @{
            bool anyReceived = Model.OrderItems.Any(i => i.Status == "Received");
        }
        @if (Model.Status != "Cancelled" && Model.Status != "Complete" && anyReceived)
        {
            <!-- Items already received: the whole order can no longer be cancelled -->
            <hr />
            <div class="d-flex gap-2 align-items-center">
                <div class="flex-grow-1 small text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    This order can't be cancelled because items have already been received.
                    You can still cancel the outstanding items below.
                </div>
                <button type="button" class="btn btn-danger btn-sm" disabled
                        title="Items have already been received">
                    <i class="bi bi-x-circle me-1"></i>Cancel Order
                </button>
            </div>
        }
        else if (Model.Status != "Cancelled" && Model.Status != "Complete")
        {
            <hr />
            <form asp-action="CancelOrder" method="post" class="d-flex gap-2 align-items-end">
                <input type="hidden" name="orderId" value="@Model.Id" />
                <div class="flex-grow-1">
                    <label class="form-label small fw-semibold">Cancel Entire Order - Reason</label>
                    <input type="text" name="reason" class="form-control form-control-sm" placeholder="Reason for cancellation" required />
                </div>
                <button class="btn btn-danger btn-sm"
                        onclick="return hemaConfirm(this, 'Cancel this entire order? This cannot be undone.', { title: 'Cancel Order', confirmText: 'Cancel Order' })">
                    <i class="bi bi-x-circle me-1"></i>Cancel Order
                </button>
            </form>
        }
    </div>
</div>

<!-- Order items -->
<div class="card shadow-sm border-0">
    <div class="card-body">
        <h5 class="mb-3">Order Items</h5>
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Consumable</th>
                    <th>Qty Ordered</th>
                    <th>Status</th>
                    <th>Date Received</th>
                    <th>Cancellation Reason</th>
                    <th style="min-width:200px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    string ibadge = item.Status == "Received" ? "success" : item.Status == "Cancelled" ? "danger" : "warning";
                    <tr>
                        <td><strong>@item.Consumable?.Name</strong></td>
                        <td>@item.QuantityOrdered</td>
                        <td><span class="badge bg-@ibadge">@item.Status</span></td>
                        <td>@(item.DateReceived?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@(item.CancellationReason ?? "-")</td>
                        <td>
                            @if (item.Status == "Ordered")
                            {
                                <div class="d-flex gap-2">
                                    <a asp-action="ReceiveItem" asp-route-orderId="@Model.Id" asp-route-itemId="@item.Id"
                                       class="btn btn-success btn-sm">
                                        <i class="bi bi-check2 me-1"></i>Receive
                                    </a>
                                    <!-- Cancel item with reason -->
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            data-bs-toggle="collapse" data-bs-target="#cancel_@item.Id">
                                        <i class="bi bi-x me-1"></i>Cancel
                                    </button>
                                </div>
                                <div class="collapse mt-2" id="cancel_@item.Id">
                                    <form asp-action="CancelItem" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="orderId" value="@Model.Id" />
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <input type="text" name="reason" class="form-control form-control-sm" placeholder="Reason" required />
                                        <button class="btn btn-danger btn-sm">Confirm</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">No actions</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Orders</a>
</div>