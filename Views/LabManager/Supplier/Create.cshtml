@model Project.Models.LabManager.Supplier
@{
    ViewData["Title"] = "Add Supplier";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Add Supplier</h2>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card shadow-sm border-0" style="max-width:520px">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold">Supplier Name <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Lab Supplies Co" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Contact Person <span class="text-danger">*</span></label>
                <input asp-for="ContactPerson" class="form-control" placeholder="Full name" />
                <span asp-validation-for="ContactPerson" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                <input asp-for="Email" class="form-control" type="email" placeholder="supplier@email.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Save Supplier</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>