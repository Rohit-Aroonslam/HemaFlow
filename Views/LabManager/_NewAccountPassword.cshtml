@*
    Lab Manager - shows a newly created account's temporary password
    when it could not be e-mailed. Stays on screen until dismissed
    (toasts disappear after 4 seconds - too fast to copy a password).
    Used by: Views/LabManager/LMDoctor/Index and Views/LabManager/Technician/Index
*@
@{
    var newName = TempData["NewAccountName"] as string;
    var newEmail = TempData["NewAccountEmail"] as string;
    var newPassword = TempData["NewAccountPassword"] as string;
}

@if (!string.IsNullOrEmpty(newPassword))
{
    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-3 mb-4" role="alert">
        <i class="bi bi-key-fill fs-4 mt-1"></i>
        <div class="flex-grow-1">
            <div class="fw-semibold mb-1">Login details for @newName - the e-mail was not sent</div>
            <div class="small mb-2">Give these to the user. They must change the password at first login. This is only shown once.</div>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span><span class="text-muted small">Username</span> <code>@newEmail</code></span>
                <span>
                    <span class="text-muted small">Temporary password</span>
                    <code id="newAccountPassword" class="fs-6">@newPassword</code>
                </span>
                <button type="button" class="btn btn-sm btn-outline-dark" id="copyNewAccountPassword">
                    <i class="bi bi-clipboard me-1"></i>Copy password
                </button>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <script>
        (function () {
            var btn = document.getElementById('copyNewAccountPassword');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var pwd = document.getElementById('newAccountPassword').textContent;
                navigator.clipboard.writeText(pwd).then(function () {
                    btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied';
                });
            });
        })();
    </script>
}