@model Project.Models.LabManager.Technician
@{
    ViewData["Title"] = "Add Technician";
    // Set when opened from a test type's Technicians page ("New Technician")
    int? returnTestTypeId = ViewBag.ReturnTestTypeId as int?;
    var selectedIds = ViewBag.SelectedTestTypeIds as List<int> ?? new List<int>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Add Technician</h2>
    @if (returnTestTypeId.HasValue)
    {
        <a asp-controller="TestType" asp-action="Technicians" asp-route-id="@returnTestTypeId" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    }
</div>

<div class="card shadow-sm border-0" style="max-width:640px">
    <div class="card-body p-4">
        <div class="alert alert-info border-0 bg-info bg-opacity-10 mb-4">
            <i class="bi bi-info-circle me-2"></i>
            A temporary password will be auto-generated and emailed. Technician must change it on first login.
        </div>
        <form asp-action="Create" method="post">
            @if (returnTestTypeId.HasValue)
            {
                <input type="hidden" name="returnTestTypeId" value="@returnTestTypeId" />
            }

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Surname <span class="text-danger">*</span></label>
                    <input asp-for="Surname" class="form-control" />
                    <span asp-validation-for="Surname" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">SA ID Number <span class="text-danger">*</span></label>
                    <input asp-for="IdNumber" class="form-control" placeholder="13-digit ID number" />
                    <span asp-validation-for="IdNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Employee Number <span class="text-danger">*</span></label>
                    <input asp-for="EmployeeNumber" class="form-control" placeholder="e.g. EMP0042" />
                    <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Contact Number <span class="text-danger">*</span></label>
                    <input asp-for="ContactNumber" class="form-control" placeholder="e.g. 0821234567" />
                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                </div>
            </div>

            <!-- ✔ Test types grouped by category - Prof Mostert feedback -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Assign Test Types <span class="text-danger">*</span>
                    <small class="text-muted fw-normal">(at least one required)</small>
                </label>

                @if (ViewBag.Categories != null && ViewBag.TestTypes != null)
                {
                    var categories = (List<Project.Models.LabManager.TestCategory>)ViewBag.Categories;
                    var testTypes = (List<Project.Models.LabManager.TestType>)ViewBag.TestTypes;
                    var catsWithTypes = categories
                    .Where(c => testTypes.Any(t => t.TestCategoryId == c.Id))
                    .ToList();
                    // Open the category holding the pre-ticked test type (otherwise the first one)
                    var openCatId = testTypes.Where(t => selectedIds.Contains(t.Id)).Select(t => (int?)t.TestCategoryId).FirstOrDefault()
                                    ?? catsWithTypes.Select(c => (int?)c.Id).FirstOrDefault();

                    if (catsWithTypes.Any())
                    {
                        <div class="accordion" id="testTypeAccordion">
                            @for (int i = 0; i < catsWithTypes.Count; i++)
                            {
                                var cat = catsWithTypes[i];
                                var catTypes = testTypes.Where(t => t.TestCategoryId == cat.Id).ToList();
                                var collapseId = $"collapse_{cat.Id}";
                                var headingId = $"heading_{cat.Id}";

                                <div class="accordion-item border mb-1 rounded">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button class="accordion-button @(cat.Id == openCatId ? "" : "collapsed") py-2 px-3 fw-semibold"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="@(cat.Id == openCatId ? "true" : "false")"
                                                aria-controls="@collapseId"
                                                style="font-size:0.85rem">
                                            <i class="bi bi-tags me-2 text-primary"></i>@cat.Name
                                            <span class="badge bg-primary bg-opacity-10 text-primary ms-2" style="font-size:0.7rem">
                                                @catTypes.Count type@(catTypes.Count != 1 ? "s" : "")
                                            </span>
                                        </button>
                                    </h2>
                                    <div id="@collapseId"
                                         class="accordion-collapse collapse @(cat.Id == openCatId ? "show" : "")"
                                         aria-labelledby="@headingId"
                                         data-bs-parent="#testTypeAccordion">
                                        <div class="accordion-body py-2 px-3">
                                            @foreach (var tt in catTypes)
                                            {
                                                <div class="form-check mb-1">
                                                    <input type="checkbox"
                                                           name="selectedTestTypes"
                                                           value="@tt.Id"
                                                           class="form-check-input"
                                                           id="tt_@tt.Id"
                                                           @(selectedIds.Contains(tt.Id) ? "checked" : "") />
                                                    <label class="form-check-label small" for="tt_@tt.Id">
                                                        @tt.Name
                                                        <span class="text-muted">(@tt.Units, @tt.TurnaroundTime min)</span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="card bg-light border-0 p-3">
                            <p class="text-muted mb-0 small">No test types available. Add test types first.</p>
                        </div>
                    }
                }
                else
                {
                    <div class="card bg-light border-0 p-3">
                        <p class="text-muted mb-0 small">No categories or test types available.</p>
                    </div>
                }

                <span asp-validation-for="TechnicianTestTypes" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-person-plus me-1"></i>Create Technician
                </button>
                @if (returnTestTypeId.HasValue)
                {
                    <a asp-controller="TestType" asp-action="Technicians" asp-route-id="@returnTestTypeId" class="btn btn-outline-secondary">Cancel</a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                }
            </div>

        </form>
    </div>
</div>