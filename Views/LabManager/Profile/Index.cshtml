@model Project.Models.LabManager.ManagerProfile
@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">My Profile</h2>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

<div class="row g-4">
    <!-- Profile card -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center p-5">
                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                     style="width:80px;height:80px;font-size:2rem">
                    @Model.Name.Substring(0, 1).ToUpper()@Model.Surname.Substring(0, 1).ToUpper()
                </div>
                <h4 class="mb-0">@Model.Name @Model.Surname</h4>
                <p class="text-muted mb-3">Laboratory Manager</p>
                <hr />
                <div class="text-start">
                    <div class="mb-3">
                        <small class="text-muted d-block">Email / Username</small>
                        <strong>@Model.Email</strong>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Contact Number</small>
                        <strong>@Model.ContactNumber</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block">Password</small>
                        <strong>••••••••</strong>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white border-0 pb-4 px-4 d-flex gap-2">
                <a asp-action="Edit" class="btn btn-warning w-100">
                    <i class="bi bi-pencil me-1"></i>Edit Profile
                </a>
                <a asp-action="ChangePassword" class="btn btn-outline-dark w-100">
                    <i class="bi bi-lock me-1"></i>Change Password
                </a>
            </div>
        </div>
    </div>

    <!-- Recent activity -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-3">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>My Recent Activity</h5>
                <a asp-controller="ActivityLog" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Time</th>
                            <th>Action</th>
                            <th>Record</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var recent = (List<Project.Models.LabManager.ActivityLog>)ViewBag.RecentActivity;
                        }
                        @foreach (var entry in recent)
                        {
                            string bc = entry.Action switch
                            {
                                "Created" => "success",
                                "Updated" => "warning",
                                "Archived" => "danger",
                                "Restored" => "info",
                                "StockAdjusted" => "primary",
                                "OrderPlaced" => "secondary",
                                "OrderCompleted" => "success",
                                "OrderCancelled" => "danger",
                                _ => "secondary"
                            };
                            <tr>
                                <td class="ps-4 text-muted small">@entry.Timestamp.ToString("MM-dd HH:mm")</td>
                                <td><span class="badge bg-@bc">@entry.Action</span></td>
                                <td><strong>@entry.EntityName</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>