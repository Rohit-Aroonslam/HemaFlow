@model IEnumerable<Project.Models.LabManager.Consumable>
@{
    ViewData["Title"] = "Consumables";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Consumables</h2>
    <div class="d-flex gap-2">
        <a asp-action="Archived" class="btn btn-outline-secondary"><i class="bi bi-archive me-1"></i>View Archived</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Consumable</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Supplier</th>
                    <th>Stock</th>
                    <th class="text-nowrap">Reorder Level</th>
                    <th>Status</th>
                    <th style="min-width:260px">Adjust Stock</th>
                    <th class="text-end pe-4 text-nowrap">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        bool isLow = item.QuantityOnHand <= item.ReorderLevel * 1.1;
                        <tr class="@(isLow ? "table-danger" : "")">
                            <td class="ps-4"><strong>@item.Name</strong></td>
                            <td>@item.Supplier?.Name</td>
                            <td>
                                <strong class="@(isLow ? "text-danger" : "text-success")">@item.QuantityOnHand</strong>
                            </td>
                            <td>@item.ReorderLevel</td>
                            <td>
                                @if (isLow)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">OK</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 mb-2">
                                    <a asp-action="AdjustStock" asp-route-id="@item.Id" asp-route-mode="increase" asp-route-value="10"
                                       class="btn btn-success btn-sm">+10</a>
                                    <a asp-action="AdjustStock" asp-route-id="@item.Id" asp-route-mode="decrease" asp-route-value="10"
                                       class="btn btn-warning btn-sm">-10</a>
                                </div>
                                <form asp-action="AdjustStockPost" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <select name="mode" class="form-select form-select-sm" style="width:100px">
                                        <option value="increase">Increase</option>
                                        <option value="decrease">Decrease</option>
                                        <option value="set">Set</option>
                                    </select>
                                    <input type="number" name="value" class="form-control form-control-sm" style="width:80px" min="0" required />
                                    <button class="btn btn-primary btn-sm">Apply</button>
                                </form>
                            </td>
                            <td class="text-end pe-4 text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Archive" asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return hemaConfirm(this, 'Archive @item.Name?', { title: 'Archive Consumable', confirmText: 'Archive' })">
                                    <i class="bi bi-archive"></i> Archive
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>No consumables found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>