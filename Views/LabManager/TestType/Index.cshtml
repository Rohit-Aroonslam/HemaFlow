@model IEnumerable<Project.Models.LabManager.TestType>
@{
    ViewData["Title"] = "Test Types";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Test Types</h2>
    <div class="d-flex gap-2">
        <a asp-action="Archived" class="btn btn-outline-secondary"><i class="bi bi-archive me-1"></i>View Archived</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Test Type</a>
    </div>
</div>
<div class="card shadow-sm border-0">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Category</th>
                    <th>Sample Type</th>
                    <th>Units</th>
                    <th>Normal Range</th>
                    <th>TAT (min)</th>
                    <th class="text-end pe-4 text-nowrap">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4"><strong>@item.Name</strong></td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary">@item.TestCategory?.Name</span></td>
                            <td>@item.SampleType?.Name</td>
                            <td><code>@item.Units</code></td>
                            <td>@item.NormalMin – @item.NormalMax</td>
                            <td>@item.TurnaroundTime</td>
                            <td class="text-end pe-4 text-nowrap">
                                <a asp-action="Technicians" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm me-1">
                                    <i class="bi bi-people"></i> Technicians
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Archive" asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return hemaConfirm(this, 'Archive @item.Name?', { title: 'Archive Test Type', confirmText: 'Archive' })">
                                    <i class="bi bi-archive"></i> Archive
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>No test types found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>