@model LabTechFilter
@*
    Dashboard filters (spec: urgency, category, due time, request number).
    Used on the dashboard itself and inside each list modal - a modal's copy
    carries ViewData["Open"] so the same modal re-opens after filtering.
*@
@{
    var categories = (List<TestCategory>)ViewData["Categories"]!;
    var open = ViewData["Open"] as string;
    var compact = !string.IsNullOrEmpty(open);
}

<form asp-controller="LabTech" asp-action="Dashboard" method="get" class="lt-filters row g-2 align-items-end">
    @if (compact)
    {
        <input type="hidden" name="open" value="@open" />
    }
    <div class="col-6 col-md-3">
        <label class="form-label small fw-bold text-uppercase mb-1">Urgency</label>
        <select name="urgency" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (var u in new[] { "STAT", "Urgent", "Routine" })
            {
                <option value="@u" selected="@(Model.Urgency == u)">@u</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small fw-bold text-uppercase mb-1">Category</label>
        <select name="category" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(Model.Category == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small fw-bold text-uppercase mb-1">Due time</label>
        <select name="due" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="overdue" selected="@(Model.Due == "overdue")">Overdue</option>
            <option value="nearing" selected="@(Model.Due == "nearing")">Nearing limit</option>
            <option value="ontime" selected="@(Model.Due == "ontime")">On time</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small fw-bold text-uppercase mb-1">Request #</label>
        <input type="search" name="req" data-live-search value="@Model.Req" class="form-control form-control-sm" placeholder="e.g. 1042" />
    </div>
    <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3 flex-fill"><i class="bi bi-funnel me-1"></i>Apply</button>
        @if (Model.Any)
        {
            <a asp-controller="LabTech" asp-action="Dashboard" asp-route-open="@open" class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="Clear filters">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </div>
</form>
