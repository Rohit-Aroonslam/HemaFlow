@model LabTechQueueList
@*
    One bento card (used by both the "Needs Attention" and "Your Workflow"
    groups on the Dashboard) - header with icon/title/count, up to 3 preview
    rows, and a "View all" footer that opens the matching _QueueModal.
*@
@{
    bool filterActive = ViewBag.FilterActive as bool? ?? false;
    string UrgClass(string u) => u == "STAT" ? "badge-stat" : u == "Urgent" ? "badge-urgent" : "badge-routine";
    var (toneBg, toneFg) = Model.Tone;
}
<div class="bento-card" style="border-top: 3px solid @toneFg;">
    <div class="bento-card-header">
        <span class="bento-icon-chip" style="background:@toneBg; color:@toneFg;"><i class="bi @Model.Icon"></i></span>
        <h6 class="bento-card-title">@Model.Title</h6>
        <span class="bento-count" style="background:@toneBg; color:@toneFg;">@Model.Items.Count</span>
    </div>
    <div class="bento-body">
        @if (!Model.Items.Any())
        {
            <div class="bento-empty">@(filterActive ? "Nothing matches the filters." : Model.Empty)</div>
        }
        @foreach (var item in Model.Items.Take(3))
        {
            <div class="bento-item">
                <div class="bento-item-main">
                    <span class="bento-item-id">@item.RequestNumber</span><span class="bento-item-name">@item.TestTypeName</span>
                    <span class="badge @UrgClass(item.Urgency) rounded-pill px-2 ms-1">@item.Urgency</span>
                    <div class="bento-item-sub">
                        @item.CategoryName &middot;
                        @if (item.Status is "Verify")
                        {
                            @:Captured by @item.CapturedBy
                        }
                        else
                        {
                            <span class="@(item.IsOverdue ? "text-danger fw-semibold" : item.IsNearingTat ? "text-warning fw-semibold" : "")">@item.DueText</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="bento-card-footer">
        <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 w-100" data-bs-toggle="modal" data-bs-target="#modal-@Model.Key">
            View all (@Model.Items.Count) <i class="bi bi-arrow-right ms-1"></i>
        </button>
    </div>
</div>
