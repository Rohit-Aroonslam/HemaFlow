@model LabTechProfileViewModel
@{
    Layout = "_LabTechLayout";
    ViewData["Title"] = "My Profile";
    string initials = (string.IsNullOrEmpty(Model.FirstName) ? "" : Model.FirstName[0].ToString())
                     + (string.IsNullOrEmpty(Model.Surname) ? "" : Model.Surname[0].ToString());
}

<div class="mb-4">
    <h2 class="serif-brand mb-1">My Profile</h2>
    <p class="text-muted mb-0">Your details, assigned tests, and account security - all in one place.</p>
</div>

<div class="row g-4">

    @* ── Identity card: avatar + key facts, the "who" at a glance ── *@
    <div class="col-lg-4">
        <div class="glass-card p-4 text-center mb-4">
            <div class="profile-avatar mx-auto mb-3">@initials</div>
            <h4 class="serif-brand mb-0">@Model.FirstName @Model.Surname</h4>
            <p class="text-muted small mb-3">Lab Technician</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap mb-4">
                <span class="badge bg-light text-dark border px-3">@Model.EmployeeCode</span>
                @if (Model.TwoFactorEnabled)
                {
                    <span class="badge bg-success-subtle text-success border px-3"><i class="bi bi-shield-check me-1"></i>2FA On</span>
                }
                else
                {
                    <span class="badge bg-light text-dark border px-3"><i class="bi bi-shield-x text-danger me-1"></i>2FA Off</span>
                }
            </div>
            <dl class="info-grid text-start mb-0">
                <dt>Email</dt>
                <dd class="text-truncate">@Model.Email</dd>
                <dt>Phone</dt>
                <dd>@Model.Phone</dd>
                <dt>SA ID</dt>
                <dd>@Model.SaIdNumber</dd>
            </dl>
        </div>

        <div class="glass-card p-4">
            <h6 class="text-muted text-uppercase fw-bold small mb-3"><i class="bi bi-ui-checks-grid me-1"></i>Assigned Tests</h6>
            <p class="text-muted small mb-3" style="font-size:0.75rem;">The only tests you'll see in Available Tests and can verify.</p>
            <div class="d-flex flex-wrap gap-2">
                @if (Model.AssignedTestTypes.Any())
                {
                    @foreach (var name in Model.AssignedTestTypes)
                    {
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">@name</span>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">No test types assigned yet.</p>
                }
            </div>
        </div>
    </div>

    @* ── Tabbed content: Personal Info / Security, one card instead of five ── *@
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="pt-tabs nav border-bottom mb-4">
                <button type="button" class="pt-tab active" data-bs-toggle="tab" data-bs-target="#tab-info">
                    <i class="bi bi-person-lines-fill"></i>Personal Info
                </button>
                <button type="button" class="pt-tab" data-bs-toggle="tab" data-bs-target="#tab-security">
                    <i class="bi bi-shield-lock"></i>Security
                </button>
            </div>

            <div class="tab-content">

                <div class="tab-pane fade show active" id="tab-info">
                    <form asp-controller="LabTech" asp-action="Profile" method="post">
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-uppercase">First Name</label>
                                <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-uppercase">Last Name</label>
                                <input type="text" name="Surname" class="form-control" value="@Model.Surname" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase">
                                Email <span class="text-muted fw-normal" style="text-transform:none;">(your username)</span>
                            </label>
                            <input type="email" name="Email" class="form-control" value="@Model.Email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase">Contact Number</label>
                            <input type="tel" name="Phone" class="form-control" value="@Model.Phone" />
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-uppercase">Employee ID</label>
                                <div class="form-control bg-light border text-muted d-flex align-items-center gap-2">
                                    <i class="bi bi-lock-fill"></i>@Model.EmployeeCode
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-uppercase">SA ID Number</label>
                                <div class="form-control bg-light border text-muted d-flex align-items-center gap-2">
                                    <i class="bi bi-lock-fill"></i>@Model.SaIdNumber
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-dark rounded-pill px-4">
                                <i class="bi bi-check-lg me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="tab-security">

                    <div class="security-row">
                        <div>
                            <div class="fw-medium small">Password</div>
                            <div class="text-muted" style="font-size:0.78rem;">Change the password used to sign in.</div>
                        </div>
                        <a asp-controller="LabTech" asp-action="ChangePassword" class="btn btn-outline-dark btn-sm rounded-pill px-3 text-nowrap">
                            <i class="bi bi-key me-1"></i>Change
                        </a>
                    </div>

                    <div class="security-row align-items-start">
                        <div class="d-flex align-items-start gap-3">
                            <span class="profile-icon-chip" style="background:#dbeafe; color:#1e40af;"><i class="bi bi-phone"></i></span>
                            <div>
                                <div class="fw-medium small">Two-Factor Authentication</div>
                                <div class="text-muted" style="font-size:0.78rem;">
                                    @if (Model.TwoFactorEnabled)
                                    {
                                        @:Enabled &bull; last verified @(Model.TwoFactorLastVerified?.ToString("dd MMM yyyy, HH:mm") ?? "-") &bull; @Model.BackupCodesLeft backup codes left
                                    }
                                    else
                                    {
                                        @:Not enabled - add an authenticator app for a second sign-in factor.
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 flex-wrap flex-shrink-0">
                            @if (Model.TwoFactorEnabled)
                            {
                                <form asp-controller="LabTech" asp-action="RegenerateBackupCodes" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-dark btn-sm rounded-pill px-3 text-nowrap"><i class="bi bi-key me-1"></i>New Codes</button>
                                </form>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 text-nowrap" data-bs-toggle="modal" data-bs-target="#disable2FAModal">Disable</button>
                            }
                            else
                            {
                                <a asp-controller="LabTech" asp-action="Setup2FA" class="btn btn-dark btn-sm rounded-pill px-3 text-nowrap"><i class="bi bi-shield-plus me-1"></i>Set Up</a>
                            }
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>


<!-- Disable 2FA Modal -->
<div class="modal fade" id="disable2FAModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border:1px solid #e1e1e1;">
            <form asp-controller="LabTech" asp-action="DisableTwoFactor" method="post">
                <div class="modal-body p-4">
                    <div class="text-center mb-3"><i class="bi bi-shield-exclamation text-danger" style="font-size:2rem;"></i></div>
                    <p class="fw-semibold mb-1 text-center">Disable Two-Factor Authentication?</p>
                    <p class="text-muted small text-center mb-3">This will reduce the security of your account. Enter your password to confirm.</p>
                    <input type="password" name="password" class="form-control mb-3" placeholder="Enter your password to confirm" required autocomplete="current-password">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-dark btn-sm rounded-pill flex-grow-1" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm rounded-pill flex-grow-1">Disable</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.NewBackupCodes.Any())
{
<!-- Backup Codes Modal (shown once, right after generation) -->
<div class="modal fade" id="backupCodesModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border:1px solid #e1e1e1;">
            <div class="modal-header border-bottom" style="padding:1.5rem 1.75rem;">
                <div>
                    <h6 class="modal-title fw-bold mb-1"><i class="bi bi-key-fill me-2"></i>Your Backup Codes</h6>
                    <p class="text-muted small mb-0">Save these now. They are shown only once and each works a single time.</p>
                </div>
            </div>
            <div class="modal-body" style="padding:1.75rem;">
                <div class="row g-2 mb-3">
                    @foreach (var code in Model.NewBackupCodes)
                    {
                        <div class="col-6 col-md-4">
                            <div class="backup-code">@code</div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-top" style="padding:1rem 1.75rem;">
                <button type="button" id="copyCodesBtn" class="btn btn-outline-dark rounded-pill px-4"><i class="bi bi-clipboard me-1"></i>Copy All</button>
                <button type="button" class="btn btn-dark rounded-pill px-4" data-bs-dismiss="modal">I've saved them</button>
            </div>
        </div>
    </div>
</div>
}

@section Styles {
<style>
    .profile-avatar {
        width: 76px; height: 76px;
        background: #0f172a; color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem; font-weight: 700; font-family: 'Georgia', serif;
    }
    .profile-icon-chip {
        width: 38px; height: 38px; flex-shrink: 0;
        display: inline-flex; align-items: center; justify-content: center;
    }
    .security-row {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        padding: 0.9rem 0; border-bottom: 1px solid #f1f5f9;
    }
    .backup-code {
        font-family: 'Courier New', monospace; font-size: 0.88rem; font-weight: 700;
        background: #f8fafc; border: 1px solid #e2e8f0; padding: 0.55rem 0.75rem;
        text-align: center; letter-spacing: 0.08em;
    }
</style>
}

@section Scripts {
@if (Model.NewBackupCodes.Any())
{
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('backupCodesModal');
        new bootstrap.Modal(el).show();
        document.getElementById('copyCodesBtn').addEventListener('click', function () {
            var codes = Array.from(el.querySelectorAll('.backup-code')).map(function (c) { return c.textContent.trim(); });
            var btn = this;
            navigator.clipboard.writeText(codes.join('\n')).then(function () {
                btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Copied';
            });
        });
    });
</script>
}
}
