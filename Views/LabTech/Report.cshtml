@using Project.Models.LabManager
@{
    Layout = "_LabTechLayout";
    ViewData["Title"] = "Technician Report";

    var items          = (List<QueueItem>)ViewBag.Items;
    var categoryGroups = (List<CategoryGroupRow>)ViewBag.CategoryGroups;
    int totalCount     = (int)ViewBag.TotalCount;
    int abnormalCount  = (int)ViewBag.AbnormalCount;
    int normalCount    = totalCount - abnormalCount;
    DateTime from      = (DateTime)ViewBag.From;
    DateTime to        = (DateTime)ViewBag.To;
    string fromStr     = from.ToString("yyyy-MM-dd");
    string toStr       = to.ToString("yyyy-MM-dd");

    // Category tone - same palette family as the Dashboard's Tone system,
    // cycled so each category reads as its own colour without inventing
    // anything outside the established set.
    (string Bg, string Fg)[] tones = new[]
    {
        ("#dbeafe", "#1e40af"), ("#d1fae5", "#065f46"), ("#ede9fe", "#5b21b6"),
        ("#fff7ed", "#ea580c"), ("#fffbeb", "#b45309"), ("#e2e8f0", "#334155")
    };
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="serif-brand mb-1">Technician Report</h2>
        <p class="text-muted mb-0">Tests you've completed, grouped by category, for a date range you pick.</p>
    </div>
</div>

@* ── Quick ranges (action, not just manual date entry) ── *@
<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-sm @(from == DateTime.Now.AddDays(-7).Date && to.Date == DateTime.Now.Date ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3"
       asp-action="Report" asp-route-from="@DateTime.Now.AddDays(-7).ToString("yyyy-MM-dd")" asp-route-to="@DateTime.Now.ToString("yyyy-MM-dd")">Last 7 days</a>
    <a class="btn btn-sm @(from == DateTime.Now.AddDays(-30).Date && to.Date == DateTime.Now.Date ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3"
       asp-action="Report" asp-route-from="@DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd")" asp-route-to="@DateTime.Now.ToString("yyyy-MM-dd")">Last 30 days</a>
    <a class="btn btn-sm @(from == new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1) && to.Date == DateTime.Now.Date ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3"
       asp-action="Report" asp-route-from="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("yyyy-MM-dd"))" asp-route-to="@DateTime.Now.ToString("yyyy-MM-dd")">This month</a>
</div>

@* ── Stat tiles for the selected range ── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="glass-card p-3" style="border-bottom:3px solid #1e40af;">
            <span class="report-icon-chip" style="background:#dbeafe; color:#1e40af;"><i class="bi bi-clipboard2-check"></i></span>
            <h2 class="serif-brand mb-0 mt-2" style="color:#1e40af;">@totalCount</h2>
            <p class="report-stat-caption mb-0">Completed</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="glass-card p-3" style="border-bottom:3px solid #065f46;">
            <span class="report-icon-chip" style="background:#d1fae5; color:#065f46;"><i class="bi bi-check-circle"></i></span>
            <h2 class="serif-brand mb-0 mt-2" style="color:#065f46;">@normalCount</h2>
            <p class="report-stat-caption mb-0">Normal</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="glass-card p-3" style="border-bottom:3px solid #dc2626;">
            <span class="report-icon-chip" style="background:#fee2e2; color:#dc2626;"><i class="bi bi-exclamation-triangle"></i></span>
            <h2 class="serif-brand mb-0 mt-2" style="color:#dc2626;">@abnormalCount</h2>
            <p class="report-stat-caption mb-0">Abnormal</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="glass-card p-3" style="border-bottom:3px solid #334155;">
            <span class="report-icon-chip" style="background:#e2e8f0; color:#334155;"><i class="bi bi-tags"></i></span>
            <h2 class="serif-brand mb-0 mt-2" style="color:#334155;">@categoryGroups.Count</h2>
            <p class="report-stat-caption mb-0">Categories</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="glass-card p-5 mb-4">
            <h6 class="text-muted text-uppercase fw-bold small mb-3">Generate Report</h6>
            <p class="text-muted small mb-4">
                Pick a date range, preview the branded PDF, then download it or e-mail yourself a copy.
            </p>

            <form asp-controller="LabTech" asp-action="Report" method="post" id="reportForm">
                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase">From</label>
                    <input type="date" name="from" id="reportFrom" class="form-control" value="@fromStr" />
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase">To</label>
                    <input type="date" name="to" id="reportTo" class="form-control" value="@toStr" />
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-dark rounded-pill px-4" id="previewBtn">
                        <i class="bi bi-eye me-1"></i>Preview
                    </button>
                    <button type="submit" class="btn btn-dark rounded-pill px-4" data-confirm="Download the PDF report for the selected date range?">
                        <i class="bi bi-file-earmark-arrow-down me-1"></i>Download PDF
                    </button>
                </div>
            </form>
            <form asp-controller="LabTech" asp-action="EmailReport" method="post" class="confirm-form mt-2"
                  data-message="E-mail yourself a copy of this report?">
                <input type="hidden" name="from" value="@fromStr" />
                <input type="hidden" name="to" value="@toStr" />
                <button type="submit" class="btn btn-outline-secondary rounded-pill px-4 w-100">
                    <i class="bi bi-envelope me-1"></i>Email Me a Copy
                </button>
            </form>
        </div>

        @* ── Category breakdown: the spec's "grouped by category" made visible,
             not just buried inside the PDF. ── *@
        <div class="glass-card p-4">
            <h6 class="text-muted text-uppercase fw-bold small mb-3">By Category</h6>
            @if (categoryGroups.Count == 0)
            {
                <p class="text-muted small mb-0">Nothing completed in this range yet.</p>
            }
            @{ int ti = 0; }
            @foreach (var g in categoryGroups)
            {
                var tone = tones[ti % tones.Length]; ti++;
                <div class="report-cat-row">
                    <span class="report-cat-dot" style="background:@tone.Fg;"></span>
                    <span class="report-cat-name">@g.Category</span>
                    <span class="badge rounded-pill px-3" style="background:@tone.Bg; color:@tone.Fg;">@g.Count</span>
                    @if (g.Abnormal > 0)
                    {
                        <span class="text-danger small ms-2">@g.Abnormal abnormal</span>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="text-muted text-uppercase fw-bold small mb-0">Completed Tests &middot; @from.ToString("dd MMM") &ndash; @to.ToString("dd MMM yyyy")</h6>
                <span class="small text-muted">@totalCount result@(totalCount == 1 ? "" : "s")</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>REQUEST #</th>
                            <th>TEST TYPE</th>
                            <th>CATEGORY</th>
                            <th>RESULT</th>
                            <th>FLAG</th>
                            <th>COMPLETED</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!items.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No completed tests in this range.</td></tr>
                        }
                        @foreach (var item in items)
                        {
                            bool abnormal = item.Flag == "Abnormal";
                            <tr>
                                <td class="fw-bold">@item.RequestNumber</td>
                                <td>@item.TestTypeName</td>
                                <td class="text-muted">@item.CategoryName</td>
                                <td class="fw-semibold @(abnormal ? "text-danger" : "text-success")">@item.ResultValue @item.ResultUnits</td>
                                <td>
                                    @if (abnormal)
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Abnormal</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3">Normal</span>
                                    }
                                </td>
                                <td>@(item.CapturedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ── PDF preview modal - renders the same branded report inline via <iframe>
     before the technician commits to downloading it. ─────────────────────── *@
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius:0.75rem; border:1px solid #e1e1e1;">
            <div class="modal-header border-bottom" style="padding:1.5rem 1.75rem;">
                <div>
                    <h6 class="modal-title fw-bold mb-1"><i class="bi bi-file-earmark-pdf me-2 text-danger"></i>Report Preview</h6>
                    <p class="text-muted small mb-0">This is exactly what will download - review it, then close or download below.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="background:#525659;">
                <div id="previewLoading" class="text-center text-white-50 py-5">
                    <div class="loading-bars sm"><span></span><span></span><span></span><span></span><span></span></div>
                </div>
                <iframe id="previewFrame" title="Report PDF preview" style="width:100%; height:70vh; border:0; display:none;"></iframe>
            </div>
            <div class="modal-footer border-top" style="padding:1rem 1.75rem;">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-dark rounded-pill px-4" id="previewDownloadBtn">
                    <i class="bi bi-file-earmark-arrow-down me-1"></i>Download PDF
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .report-icon-chip {
        width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center;
    }
    .report-stat-caption { font-size: 0.72rem; font-weight: 600; color: #64748b; margin-top: 0.3rem; }
    .report-cat-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0; border-bottom: 1px solid #f1f5f9; }
    .report-cat-row:last-child { border-bottom: 0; }
    .report-cat-dot { width: 8px; height: 8px; flex-shrink: 0; }
    .report-cat-name { flex: 1; font-size: 0.85rem; font-weight: 500; }
</style>
}

@section Scripts {
<script>
(function () {
    var previewBtn   = document.getElementById('previewBtn');
    var downloadBtn  = document.getElementById('previewDownloadBtn');
    var frame        = document.getElementById('previewFrame');
    var loading      = document.getElementById('previewLoading');
    var form         = document.getElementById('reportForm');
    var modalEl      = document.getElementById('previewModal');
    var modal        = new bootstrap.Modal(modalEl);

    function previewUrl() {
        var from = document.getElementById('reportFrom').value;
        var to   = document.getElementById('reportTo').value;
        return '@Url.Action("PreviewReport", "LabTech")' + '?from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to);
    }

    previewBtn.addEventListener('click', function () {
        loading.style.display = '';
        frame.style.display = 'none';
        frame.src = previewUrl();
        modal.show();
    });

    frame.addEventListener('load', function () {
        loading.style.display = 'none';
        frame.style.display = '';
    });

    downloadBtn.addEventListener('click', function () {
        form.requestSubmit();
    });
})();
</script>
}
