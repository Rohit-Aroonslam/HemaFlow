@model Project.Models.AccountChangePasswordViewModel
@{
    Layout = "_LabTechLayout";
    ViewData["Title"] = "Change Password";
}

<a asp-controller="LabTech" asp-action="Profile" class="btn btn-sm btn-outline-secondary rounded-pill px-3 mb-3">
    <i class="bi bi-arrow-left me-1"></i> Back to Profile
</a>
<div class="mb-4">
    <h2 class="serif-brand mb-1">Change Password</h2>
    <p class="text-muted mb-0">Update the password you use to sign in.</p>
</div>

<div class="glass-card p-5" style="max-width: 520px;">
    <h6 class="text-muted text-uppercase fw-bold small mb-4"><i class="bi bi-key me-1"></i>Update Password</h6>
    <form id="changePasswordForm" asp-controller="LabTech" asp-action="ChangePassword" method="post" novalidate>

        <div class="mb-3">
            <label class="form-label small fw-bold text-uppercase">Current Password</label>
            <input type="password" id="currentPassword" name="CurrentPassword" class="form-control" placeholder="Enter current password" required>
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold text-uppercase">New Password</label>
            <input type="password" id="newPassword" name="NewPassword" class="form-control" placeholder="Min. 8 characters" required>
            <ul class="list-unstyled mt-2 mb-0" id="pwChecklist" style="font-size:0.72rem;">
                <li class="d-flex align-items-center gap-2 mb-1" data-rule="length">
                    <i class="bi bi-x-circle-fill text-danger"></i>
                    <span class="text-muted">At least 8 characters</span>
                </li>
                <li class="d-flex align-items-center gap-2 mb-1" data-rule="upper">
                    <i class="bi bi-x-circle-fill text-danger"></i>
                    <span class="text-muted">One uppercase letter</span>
                </li>
                <li class="d-flex align-items-center gap-2 mb-1" data-rule="number">
                    <i class="bi bi-x-circle-fill text-danger"></i>
                    <span class="text-muted">One number</span>
                </li>
                <li class="d-flex align-items-center gap-2" data-rule="special">
                    <i class="bi bi-x-circle-fill text-danger"></i>
                    <span class="text-muted">One special character (e.g. !@@#$%)</span>
                </li>
            </ul>
        </div>

        <div class="mb-4">
            <label class="form-label small fw-bold text-uppercase">Confirm New Password</label>
            <input type="password" id="confirmNewPassword" name="ConfirmPassword" class="form-control" placeholder="Re-enter new password" required>
            <ul class="list-unstyled mt-1 mb-0" id="matchIndicator" style="font-size:0.72rem; display:none;">
                <li class="d-flex align-items-center gap-2" id="matchIndicatorItem">
                    <i class="bi bi-x-circle-fill text-danger"></i>
                    <span class="text-muted">Passwords match</span>
                </li>
            </ul>
        </div>

        <button type="submit" class="btn btn-dark rounded-pill w-100 fw-semibold">Update Password</button>
    </form>
</div>

@section Scripts {
<script>
(function () {
    var pwInput = document.getElementById('newPassword');
    var confirmInput = document.getElementById('confirmNewPassword');
    var matchIndicator = document.getElementById('matchIndicator');

    function updatePasswordChecklist(pw) {
        var rules = {
            length: pw.length >= 8,
            upper: /[A-Z]/.test(pw),
            number: /[0-9]/.test(pw),
            special: /[^A-Za-z0-9]/.test(pw)
        };
        Object.keys(rules).forEach(function (key) {
            var li = document.querySelector('#pwChecklist [data-rule="' + key + '"]');
            if (!li) return;
            var icon = li.querySelector('i');
            var label = li.querySelector('span');
            if (rules[key]) {
                icon.className = 'bi bi-check-circle-fill text-success';
                label.classList.remove('text-muted'); label.classList.add('text-success');
            } else {
                icon.className = 'bi bi-x-circle-fill text-danger';
                label.classList.remove('text-success'); label.classList.add('text-muted');
            }
        });
    }

    function checkMatch() {
        var pw = pwInput.value, cp = confirmInput.value;
        var icon = document.querySelector('#matchIndicatorItem i');
        var label = document.querySelector('#matchIndicatorItem span');
        if (!cp) { matchIndicator.style.display = 'none'; return; }
        matchIndicator.style.display = 'block';
        if (pw === cp) {
            icon.className = 'bi bi-check-circle-fill text-success';
            label.classList.remove('text-muted'); label.classList.add('text-success');
        } else {
            icon.className = 'bi bi-x-circle-fill text-danger';
            label.classList.remove('text-success'); label.classList.add('text-muted');
        }
    }

    pwInput.addEventListener('input', function () { updatePasswordChecklist(this.value); checkMatch(); });
    confirmInput.addEventListener('input', checkMatch);

    document.getElementById('changePasswordForm').addEventListener('submit', function (e) {
        var pw = pwInput.value;
        var valid = document.getElementById('currentPassword').value.trim()
            && pw.length >= 8 && /[A-Z]/.test(pw) && /[0-9]/.test(pw) && /[^A-Za-z0-9]/.test(pw)
            && pw === confirmInput.value;
        if (!valid) e.preventDefault();
    });
})();
</script>
}
