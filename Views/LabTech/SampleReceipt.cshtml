@{
    Layout = "_LabTechLayout";
    ViewData["Title"] = "Receive Samples";

    var pending = (List<List<QueueItem>>)ViewBag.Pending;
    string UrgClass(string u) => u == "STAT" ? "badge-stat" : u == "Urgent" ? "badge-urgent" : "badge-routine";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="serif-brand">Receive Samples</h2>
        <p class="text-muted mb-0">@pending.Count request@(pending.Count == 1 ? "" : "s") waiting for samples to be received.</p>
    </div>
</div>

@if (!pending.Any())
{
    <div class="glass-card p-5 text-center text-muted">
        <i class="bi bi-inbox fs-3 d-block mb-2 opacity-40"></i>
        No submitted requests are waiting for samples.
    </div>
}

<div class="d-flex flex-column gap-3">
    @foreach (var items in pending)
    {
        var r = items[0];
        var reqId = r.RequestNumber.TrimStart('#');
        var sampleCount = items.Select(i => i.Barcode).Distinct().Count();
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="fw-semibold">Request @r.RequestNumber</span>
                        <span class="badge @UrgClass(r.Urgency) rounded-pill px-3">@r.Urgency</span>
                    </div>
                    <div class="text-muted small mb-2">
                        @r.RequestDate.ToString("dd MMM yyyy HH:mm") &middot; @r.DoctorName &middot; @sampleCount sample@(sampleCount == 1 ? "" : "s")
                    </div>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var t in items)
                        {
                            <span class="badge bg-light text-dark border rounded-pill px-3">@t.TestTypeName</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(r.ClinicalNotes))
                    {
                        <div class="text-muted small"><span class="fw-medium">Clinical notes:</span> @r.ClinicalNotes</div>
                    }
                </div>
                <div class="flex-shrink-0 d-flex gap-2">
                    <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3"
                            data-bs-toggle="modal" data-bs-target="#cancel-@reqId">
                        Cancel Request
                    </button>
                    <a asp-controller="LabTech" asp-action="ReceiveSample" asp-route-id="@reqId" class="btn btn-dark btn-sm rounded-pill px-4">
                        <i class="bi bi-droplet-fill me-1"></i>Receive
                    </a>
                </div>
            </div>
        </div>

        <div class="modal fade" id="cancel-@reqId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius:0.75rem; border:1px solid #e1e1e1;">
                    <form asp-controller="LabTech" asp-action="CancelRequest" method="post">
                        <input type="hidden" name="requestNumber" value="@r.RequestNumber" />
                        <div class="modal-header border-bottom" style="padding:1.5rem 1.75rem;">
                            <div>
                                <h6 class="modal-title fw-bold mb-1">Cancel Request @r.RequestNumber</h6>
                                <p class="text-muted small mb-0">@r.DoctorName will be e-mailed with your reason.</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" style="padding:1.75rem;">
                            <label class="form-label small fw-bold text-uppercase">Reason for cancelling</label>
                            <textarea name="reason" class="form-control" rows="3" required
                                      placeholder="e.g. Sample not delivered, sample leaked in transit…"></textarea>
                        </div>
                        <div class="modal-footer border-top" style="padding:1rem 1.75rem;">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Keep Request</button>
                            <button type="submit" class="btn btn-dark rounded-pill px-4">Cancel Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
