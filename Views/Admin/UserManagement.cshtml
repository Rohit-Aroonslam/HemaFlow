@model Project.Models.UserManagementViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Management | Hema Flow";
}

<div class="row align-items-center mb-4 g-3">
    <div class="col-md-6">
        <h4 class="fw-700 mb-1" style="color: #0f172a;">User Management</h4>
        <p class="text-muted small mb-0">@(Model.ShowArchived
            ? "Archived accounts. These users can no longer sign in and cannot be changed here."
            : "View and manage staff accounts. Use the Manage dropdown to edit, reset a password, or deactivate. Only a Super Admin can manage Admin accounts.")</p>
    </div>
    <div class="col-md-6 text-md-end d-flex gap-2 justify-content-md-end flex-wrap">
        @if (Model.ShowArchived)
        {
            <a asp-action="UserManagement" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Active users</a>
        }
        else
        {
            <a asp-action="UserManagement" asp-route-archived="true" class="btn btn-outline-secondary"><i class="bi bi-archive me-2"></i>Archived (@Model.ArchivedCount)</a>
        }
        <a asp-controller="Admin" asp-action="CreateLabManager" class="btn btn-outline-dark">
            <i class="bi bi-person-plus me-2"></i>Add Lab Manager
        </a>
        @if (User.IsInRole("SuperAdmin"))
        {
            <a asp-controller="Admin" asp-action="CreateAdminUser" class="btn btn-dark">
                <i class="bi bi-person-plus-fill me-2"></i>Create Admin
            </a>
        }
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div data-toast="danger" class="alert alert-danger rounded-0 border-0 border-start border-3 border-danger small mb-4">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
    </div>
}

@* Role / status filters + search *@
@{
    var roleList = Model.Users.Select(u => u.Role).Where(r => r != "Patient" && r != "Doctor").Distinct().OrderBy(r => r).ToList();
}
<div class="row g-3 mb-4 align-items-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-dark py-1 px-3 role-filter active" data-role="" style="font-size:0.75rem !important;">All (@Model.Users.Count)</button>
            @foreach (var r in roleList)
            {
                <button type="button" class="btn btn-outline-secondary py-1 px-3 role-filter" data-role="@r" style="font-size:0.75rem !important;">@r (@Model.Users.Count(u => u.Role == r))</button>
            }
        </div>
    </div>
    <div class="col-lg-2 col-md-4">
        <select id="statusFilter" class="form-select bg-white border rounded-0 shadow-none py-1 small">
            <option value="">All statuses</option>
            <option value="Active">Active</option>
            <option value="Pending">Pending</option>
            <option value="Inactive">Inactive</option>
        </select>
    </div>
    <div class="col-lg-4 col-md-8">
        <div class="input-group bg-white border px-2 py-1">
            <span class="input-group-text bg-transparent border-0 text-muted p-0 me-2"><i class="bi bi-search"></i></span>
            <input type="text" id="userSearch" class="form-control border-0 bg-transparent shadow-none p-0 small text-dark" placeholder="Search name, email or ID...">
        </div>
    </div>
</div>

<div class="card mb-0">
    <div class="p-0">
        <div style="overflow:visible;">
            <table class="table table-hover align-middle mb-0" style="font-size:0.82rem;" id="userTable">
                <thead>
                    <tr class="bg-light text-muted text-uppercase fw-600" style="font-size:0.68rem; border-bottom:1px solid #e2e8f0;">
                        <th class="ps-3 py-2">User ID</th>
                        <th class="py-2">Name</th>
                        <th class="py-2">Role</th>
                        <th class="py-2">Email</th>
                        <th class="py-2">Status</th>
                        <th class="text-end pe-3 py-2">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        var roleColor = u.Role switch { "Doctor" => "dark", "Technician" => "primary", _ => "secondary" };
                        var statusColor = u.Status switch { "Active" => "success", "Pending" => "warning", "Archived" => "secondary", _ => "danger" };
                        <tr style="border-bottom:1px solid #f1f5f9;" data-name="@u.FullName.ToLower()" data-email="@u.Email.ToLower()" data-id="@((u.UserId + " " + u.Identifier).ToLower())" data-status="@u.Status" data-role="@u.Role">
                            <td class="ps-3 py-3 fw-600 text-dark font-monospace" style="font-size:0.75rem;">@u.UserId</td>
                            <td>
                                <div class="fw-600 text-dark">@u.FullName</div>
                                <div class="text-muted x-small">@u.Identifier</div>
                            </td>
                            <td><span class="patient-status-pill text-@roleColor border-@roleColor bg-white" style="font-size:0.65rem;">@u.Role</span></td>
                            <td class="text-muted small">@u.Email</td>
                            <td><span class="patient-status-pill text-@statusColor border-@statusColor bg-white" style="font-size:0.65rem;">@u.Status</span></td>
                            <td class="text-end pe-3">
                                @if (u.CanManage)
                                {
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-outline-secondary py-1 px-2 dropdown-toggle" style="font-size:0.72rem !important;" data-bs-toggle="dropdown">
                                        Manage
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border rounded-0 p-1" style="font-size:0.78rem;">
                                        <li>
                                            <button type="button" class="dropdown-item py-1 px-2"
                                                    data-id="@u.UserId" data-name="@u.FullName" data-email="@u.Email"
                                                    data-identifier="@u.Identifier" data-role="@u.Role" data-status="@u.Status"
                                                    onclick="openEditUser(this)">
                                                <i class="bi bi-pencil-square me-2 text-muted"></i>Edit Details
                                            </button>
                                        </li>
                                        <li>
                                            <form asp-action="ResetPassword" asp-controller="Admin" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@u.UserId" />
                                                <button type="submit" class="dropdown-item py-1 px-2">
                                                    <i class="bi bi-key me-2 text-muted"></i>Reset Password
                                                </button>
                                            </form>
                                        </li>
                                        <li><hr class="dropdown-divider my-1 opacity-50"></li>
                                        @if (u.Status != "Inactive")
                                        {
                                            <li>
                                                <form asp-action="DeactivateUser" asp-controller="Admin" method="post" class="d-inline"
                                                      data-confirm="This will immediately remove @u.FullName's access to the system. This action can be reversed later from User Management."
                                                      data-confirm-title="Deactivate @u.FullName?"
                                                      data-confirm-text="Deactivate"
                                                      data-confirm-danger="true">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@u.UserId" />
                                                    <button type="submit" class="dropdown-item py-1 px-2 text-danger">
                                                        <i class="bi bi-slash-circle me-2"></i>Deactivate
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <form asp-action="ActivateUser" asp-controller="Admin" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@u.UserId" />
                                                    <button type="submit" class="dropdown-item py-1 px-2 text-success">
                                                        <i class="bi bi-check-circle me-2"></i>Reactivate
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                }
                                else
                                {
                                    <span class="text-muted x-small">@(u.IsArchived ? "Archived" : "Super Admin only")</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Edit User Modal *@
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 bg-white" style="border-radius:0;">
            <div class="modal-header border-bottom px-4 py-3 justify-content-between">
                <h6 class="fw-700 text-dark mb-0"><i class="bi bi-pencil text-primary me-2"></i>Edit User</h6>
                <button type="button" class="btn-close shadow-none small" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="UpdateUser" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="euUserId" name="UserId" />
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Full Name <span class="text-danger">*</span></label>
                            <input type="text" id="euFullName" name="FullName" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Email <span class="text-danger">*</span></label>
                            <input type="email" id="euEmail" name="Email" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Identifier (SA ID / HPCSA / Employee No)</label>
                        <input type="text" id="euIdentifier" name="Identifier" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small">
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Role</label>
                            <input type="text" id="euRole" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" readonly disabled>
                            <div class="text-muted x-small mt-1">Role is fixed when the account is created.</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Status</label>
                            <select id="euStatus" name="Status" class="form-select bg-light border-0 rounded-0 shadow-none py-2 small">
                                <option>Active</option>
                                <option>Pending</option>
                                <option>Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditUser(btn) {
            const d = btn.dataset;
            document.getElementById('euUserId').value     = d.id;
            document.getElementById('euFullName').value   = d.name;
            document.getElementById('euEmail').value      = d.email;
            document.getElementById('euIdentifier').value = d.identifier;
            document.getElementById('euRole').value       = d.role;
            const statEl = document.getElementById('euStatus');
            for (let o of statEl.options) { o.selected = (o.value === d.status); }
            new bootstrap.Modal(document.getElementById('editUserModal')).show();
        }

        document.getElementById('userSearch').addEventListener('input', filterUsers);
        document.getElementById('statusFilter').addEventListener('change', filterUsers);
        document.querySelectorAll('.role-filter').forEach(btn => btn.addEventListener('click', function () {
            document.querySelectorAll('.role-filter').forEach(b => {
                b.classList.remove('active','btn-dark'); b.classList.add('btn-outline-secondary');
            });
            this.classList.add('active','btn-dark'); this.classList.remove('btn-outline-secondary');
            filterUsers();
        }));

        function filterUsers() {
            const q      = document.getElementById('userSearch').value.trim().toLowerCase();
            const role   = document.querySelector('.role-filter.active').dataset.role;
            const status = document.getElementById('statusFilter').value;
            document.querySelectorAll('#userTable tbody tr').forEach(row => {
                const textMatch = !q || row.dataset.name.includes(q) || row.dataset.email.includes(q) || row.dataset.id.includes(q);
                const roleMatch = !role || row.dataset.role === role;
                const statusMatch = !status || row.dataset.status === status;
                row.style.display = (textMatch && roleMatch && statusMatch) ? '' : 'none';
            });
        }
    </script>
}
