@model Project.Models.AllergiesViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Allergies | Hema Flow";
}

<div class="row align-items-center mb-4 g-3">
    <div class="col-md-6">
        <h4 class="fw-700 mb-1" style="color: #0f172a;">Allergies</h4>
        <p class="text-muted small mb-0">Maintain the list of allergies patients can record in their health profiles.</p>
    </div>
    <div class="col-md-6 d-flex justify-content-md-end">
        <a asp-controller="Admin" asp-action="SystemArchive" class="btn btn-outline-secondary py-2 px-3 me-2"><i class="bi bi-archive me-2"></i>View Archived</a>
        <a asp-action="ExportAllergies" asp-controller="Admin" class="btn btn-outline-secondary py-2 px-3 me-2"><i class="bi bi-file-earmark-pdf me-2 text-danger"></i>Export PDF</a><a asp-action="CreateAllergy" asp-controller="Admin" class="btn btn-dark py-2 px-3">
            <i class="bi bi-plus-lg me-2"></i>Add Allergy
        </a>
    </div>
</div>

@{
    var pendingAllergyCount = Project.Models.PendingApprovalStore.Items.Count(p => p.Status == "Pending" && p.EntityType == "Allergy");
}
@if (pendingAllergyCount > 0)
{
    <a asp-controller="Admin" asp-action="PendingApprovals" class="text-decoration-none">
        <div class="alert rounded-0 border-0 border-start border-3 mb-4 d-flex align-items-center gap-2" style="border-color:#d97706 !important; background:#fffbeb;">
            <i class="bi bi-clock-history text-warning"></i>
            <span class="small text-dark">@pendingAllergyCount patient-submitted allerg@(pendingAllergyCount == 1 ? "y" : "ies") awaiting review.</span>
        </div>
    </a>
}

<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="bg-white border p-2 px-3 d-flex align-items-center" style="height:42px;">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-0 text-muted ps-0"><i class="bi bi-search"></i></span>
                <input type="text" id="allergySearch" class="form-control border-0 shadow-none small text-dark" placeholder="Search by allergy name...">
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="d-flex gap-2">
            <select id="allergyCatFilter" class="form-select border bg-white small rounded-0" style="height:42px;">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Name">@cat.Name</option>
                }
            </select>
            <button type="button" id="allergyClearFilters" class="btn btn-outline-secondary py-2 px-3 text-nowrap" style="font-size:0.8rem;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>
</div>

<div class="card mb-0">
    <div class="card-header justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle text-warning"></i>
            <span>Allergies List</span>
        </div>
        <span class="text-muted x-small" id="allergyResultCount">@Model.Allergies.Count allergy/allergies</span>
    </div>
    <div class="p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:0.82rem;" id="allergyTable">
                <thead>
                    <tr class="bg-light text-muted text-uppercase fw-600" style="font-size:0.68rem; border-bottom:1px solid #e2e8f0;">
                        <th class="ps-3 py-2">Allergy Name</th>
                        <th class="py-2">Category</th>
                        <th class="py-2">Typical Reaction</th>
                        <th class="text-end pe-3 py-2">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Allergies)
                    {
                        <tr style="border-bottom:1px solid #f1f5f9;" data-name="@a.Name.ToLower()" data-category="@a.Category">
                            <td class="ps-3 py-3 fw-600 text-dark">@a.Name</td>
                            <td>
                                <span class="patient-status-pill text-warning border-warning bg-white" style="font-size:0.65rem;">@a.Category</span>
                            </td>
                            <td class="text-muted small">@a.TypicalReaction</td>
                            <td class="text-end pe-3">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-outline-secondary py-1 px-2" style="font-size:0.72rem !important;"
                                            data-bs-toggle="modal" data-bs-target="#editAllergyModal"
                                            onclick="openEditAllergy('@a.Id','@a.Name','@a.TypicalReaction','@a.Category')">
                                        Edit
                                    </button>
                                    <button type="button" class="btn btn-outline-danger py-1 px-2" style="font-size:0.72rem !important;"
                                            data-bs-toggle="modal" data-bs-target="#archiveAllergyModal"
                                            onclick="openArchiveAllergy('@a.Id','@a.Name')">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="allergyEmptyState" style="display:none;">
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="bi bi-search me-2"></i>No allergies match your filters.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Edit Modal *@
<div class="modal fade" id="editAllergyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 bg-white" style="border-radius:0;">
            <div class="modal-header border-bottom px-4 py-3 justify-content-between">
                <h6 class="fw-700 text-dark mb-0"><i class="bi bi-pencil text-warning me-2"></i>Edit Allergy</h6>
                <button type="button" class="btn-close shadow-none small" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="UpdateAllergy" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editAllergyId" name="Id" />
                    <div class="mb-3">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Allergy Name</label>
                        <input type="text" id="editAllergyName" name="Name" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" required>
                    </div>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Category</label>
                            <select id="editAllergyCat" name="CategoryId" class="form-select bg-light border-0 rounded-0 shadow-none py-2 small">
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id" data-name="@cat.Name">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Typical Reaction</label>
                            <input type="text" id="editAllergyReaction" name="TypicalReaction" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" placeholder="e.g. Hives, Swelling">
                        </div>
                    </div>
                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditAllergy(id, name, reaction, category) {
            document.getElementById('editAllergyId').value       = id;
            document.getElementById('editAllergyName').value     = name;
            document.getElementById('editAllergyReaction').value = reaction;
            const sel = document.getElementById('editAllergyCat');
            for (let o of sel.options) { if (o.dataset.name === category) { o.selected = true; break; } }
        }
        function openArchiveAllergy(id, name) {
            document.getElementById('archiveAllergyId').value = id;
            document.getElementById('archiveAllergyName').textContent = name;
            document.getElementById('archiveAllergyReason').value = '';
        }
        document.getElementById('allergySearch').addEventListener('input', filterAllergy);
        document.getElementById('allergyCatFilter').addEventListener('change', filterAllergy);
        document.getElementById('allergyClearFilters').addEventListener('click', function () {
            document.getElementById('allergySearch').value = '';
            document.getElementById('allergyCatFilter').value = '';
            filterAllergy();
        });
        const allergyTotal = document.querySelectorAll('#allergyTable tbody tr:not(#allergyEmptyState)').length;
        function filterAllergy() {
            const q   = document.getElementById('allergySearch').value.toLowerCase();
            const cat = document.getElementById('allergyCatFilter').value;
            let visible = 0;
            document.querySelectorAll('#allergyTable tbody tr:not(#allergyEmptyState)').forEach(row => {
                const match = row.dataset.name.includes(q) && (!cat || row.dataset.category === cat);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            document.getElementById('allergyEmptyState').style.display = visible === 0 ? '' : 'none';
            document.getElementById('allergyResultCount').textContent = 'Showing ' + visible + ' of ' + allergyTotal;
        }
    </script>
}

@* Archive Allergy Modal (with reason) *@
<div class="modal fade" id="archiveAllergyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 bg-white" style="border-radius:0;">
            <div class="modal-header border-bottom px-4 py-3 justify-content-between">
                <h6 class="fw-700 text-dark mb-0"><i class="bi bi-trash3 text-danger me-2"></i>Archive Allergy</h6>
                <button type="button" class="btn-close shadow-none small" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted">Archiving <strong id="archiveAllergyName" class="text-dark"></strong>. It can be restored later from the archive.</p>
                <form asp-action="DeleteAllergy" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="archiveAllergyId" name="id" />
                    <div class="mb-4">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Reason for Archiving <span class="text-danger">*</span></label>
                        <textarea id="archiveAllergyReason" name="reason" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" rows="2" required placeholder="e.g. Duplicate entry, incorrect classification..."></textarea>
                    </div>
                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Archive</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
