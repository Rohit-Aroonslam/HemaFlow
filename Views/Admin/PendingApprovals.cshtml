@model Project.Models.PendingApprovalsViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Pending Approvals | Hema Flow";
}

<div class="row align-items-center mb-4 g-3">
    <div class="col-md-8">
        <h4 class="fw-700 mb-1" style="color: #0f172a;">Pending Approvals</h4>
        <p class="text-muted small mb-0">Patients have submitted these as "Other" - review and either approve them onto the master list, or deny with a reason.</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div data-toast="danger" class="alert alert-danger rounded-0 border-0 border-start border-3 border-danger small mb-4">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
    </div>
}

<div class="card mb-0">
    <div class="card-header justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-clock-history text-primary"></i>
            <span>Awaiting Review</span>
        </div>
        <span class="text-muted x-small">@Model.Items.Count pending</span>
    </div>
    <div class="p-0">
        @if (!Model.Items.Any())
        {
            <div class="p-4 text-muted small">Nothing pending review right now.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size:0.82rem;">
                    <thead>
                        <tr class="bg-light text-muted text-uppercase fw-600" style="font-size:0.68rem; border-bottom:1px solid #e2e8f0;">
                            <th class="ps-3 py-2">Type</th>
                            <th class="py-2">Name</th>
                            <th class="py-2">Details</th>
                            <th class="py-2">Patient</th>
                            <th class="py-2">Submitted</th>
                            <th class="text-end pe-3 py-2">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var cats = item.EntityType == "Condition" ? Model.ConditionCategories
                                     : item.EntityType == "Allergy" ? Model.AllergyCategories
                                     : Model.MedicationCategories;
                            <tr style="border-bottom:1px solid #f1f5f9;">
                                <td class="ps-3 py-3">
                                    <span class="patient-status-pill text-primary border-primary bg-white" style="font-size:0.65rem;">@item.EntityType</span>
                                </td>
                                <td class="fw-600 text-dark">@item.Name</td>
                                <td class="text-muted x-small">@(item.ExtraInfo ?? "-")@if (!string.IsNullOrEmpty(item.SuggestedCategory)){<div>Suggested category: @item.SuggestedCategory</div>}</td>
                                <td class="text-muted x-small">
                                    <div class="fw-600 text-dark">@item.PatientName</div>
                                    <div>@item.PatientCode</div>
                                    <div>@item.PatientEmail</div>
                                    @if (item.PatientOtherPending > 0){<div class="text-primary">+@item.PatientOtherPending more pending</div>}
                                </td>
                                <td class="text-muted x-small">@item.SubmittedOn.ToString("d MMM yyyy HH:mm")</td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button type="button" class="btn btn-outline-dark py-1 px-2 js-edit-pending" style="font-size:0.72rem !important;"
                                                data-bs-toggle="modal" data-bs-target="#editModal"
                                                data-id="@item.Id" data-name="@item.Name" data-extra="@item.ExtraInfo" data-type="@item.EntityType">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary py-1 px-2 js-deny-pending" style="font-size:0.72rem !important;"
                                                data-bs-toggle="modal" data-bs-target="#denyModal"
                                                data-id="@item.Id" data-name="@item.Name">
                                            Deny
                                        </button>
                                        <button type="button" class="btn btn-outline-primary py-1 px-2 js-approve-pending" style="font-size:0.72rem !important;"
                                                data-bs-toggle="modal" data-bs-target="#approveModal"
                                                data-id="@item.Id" data-name="@item.Name" data-suggested="@item.SuggestedCategory" data-type="@item.EntityType">
                                            Approve
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>


@if (Model.Reviewed.Any())
{
    <div class="card mt-4 mb-0">
        <div class="card-header justify-content-between">
            <div class="d-flex align-items-center gap-2"><i class="bi bi-check2-circle text-primary"></i><span>Recently Reviewed</span></div>
            <span class="text-muted x-small">Last @Model.Reviewed.Count</span>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0" style="font-size:0.82rem;">
                <thead>
                    <tr class="bg-light text-muted text-uppercase fw-600" style="font-size:0.68rem; border-bottom:1px solid #e2e8f0;">
                        <th class="ps-3 py-2">Type</th><th class="py-2">Name</th><th class="py-2">Patient</th><th class="py-2">Outcome</th><th class="py-2">Reviewed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reviewed)
                    {
                        <tr style="border-bottom:1px solid #f1f5f9;">
                            <td class="ps-3 py-2 text-muted x-small">@r.EntityType</td>
                            <td class="fw-600 text-dark">@r.Name</td>
                            <td class="text-muted x-small">@r.PatientName (@r.PatientCode)</td>
                            <td>
                                <span class="patient-status-pill @(r.Status == "Approved" ? "text-success border-success" : "text-danger border-danger") bg-white" style="font-size:0.65rem;">@r.Status</span>
                                @if (!string.IsNullOrEmpty(r.DenyReason)){<div class="text-muted x-small mt-1">@r.DenyReason</div>}
                            </td>
                            <td class="text-muted x-small">@(r.ReviewedOn?.ToString("d MMM yyyy HH:mm") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Edit Modal - fix the name / details of a pending submission *@
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 bg-white" style="border-radius:0;">
            <div class="modal-header border-bottom px-4 py-3 justify-content-between">
                <h6 class="fw-700 text-dark mb-0"><i class="bi bi-pencil text-dark me-2"></i>Edit Submission</h6>
                <button type="button" class="btn-close shadow-none small" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="EditPending" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editId" name="id" />
                    <div class="mb-3">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Name <span class="text-danger">*</span></label>
                        <input type="text" id="editName" name="name" maxlength="200" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" required>
                    </div>
                    <div class="mb-4" id="editExtraWrap">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Dosage / frequency</label>
                        <input type="text" id="editExtra" name="extraInfo" maxlength="300" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small">
                    </div>
                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* Approve Modal - requires assigning a category *@
<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 bg-white" style="border-radius:0;">
            <div class="modal-header border-bottom px-4 py-3 justify-content-between">
                <h6 class="fw-700 text-dark mb-0"><i class="bi bi-check-circle text-success me-2"></i>Approve Submission</h6>
                <button type="button" class="btn-close shadow-none small" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted">Check the type, category and name, then approve. It is added to the master list and to the patient's profile.</p>
                <form asp-action="ApprovePending" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="approveId" name="id" />
                    <div class="mb-3">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Type <span class="text-danger">*</span></label>
                        <select id="approveType" name="entityType" class="form-select bg-light border-0 rounded-0 shadow-none py-2 small" required>
                            <option value="Medication">Medication</option>
                            <option value="Allergy">Allergy</option>
                            <option value="Condition">Condition</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Category <span class="text-danger">*</span></label>
                        <select id="approveCategory" name="category" class="form-select bg-light border-0 rounded-0 shadow-none py-2 small" required></select>
                        <div id="approveNoCats" class="text-danger x-small mt-1" style="display:none;">No categories exist for this type yet - add one under Categories first.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Name <span class="text-danger">*</span></label>
                        <input type="text" id="approveName" name="name" maxlength="200" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" required>
                    </div>
                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark">Approve</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* Deny Modal - requires a reason *@
<div class="modal fade" id="denyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 bg-white" style="border-radius:0;">
            <div class="modal-header border-bottom px-4 py-3 justify-content-between">
                <h6 class="fw-700 text-dark mb-0"><i class="bi bi-x-circle text-danger me-2"></i>Deny Submission</h6>
                <button type="button" class="btn-close shadow-none small" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted">Denying <strong id="denyName" class="text-dark"></strong>.</p>
                <form asp-action="DenyPending" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="denyId" name="id" />
                    <div class="mb-4">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Reason <span class="text-danger">*</span></label>
                        <textarea id="denyReason" name="reason" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" rows="2" required placeholder="e.g. Not a recognised medical term, duplicate of an existing entry..."></textarea>
                    </div>
                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Deny</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var approveCats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, List<string>> {
            ["Condition"] = Model.ConditionCategories.Select(c => c.Name).ToList(),
            ["Allergy"] = Model.AllergyCategories.Select(c => c.Name).ToList(),
            ["Medication"] = Model.MedicationCategories.Select(c => c.Name).ToList()
        }));
        function fillApproveCategories(type, selected) {
            var sel = document.getElementById('approveCategory');
            sel.innerHTML = '';
            var list = approveCats[type] || [];
            list.forEach(function (c) {
                var opt = document.createElement('option');
                opt.value = c; opt.textContent = c;
                if (c === selected) opt.selected = true;
                sel.appendChild(opt);
            });
            document.getElementById('approveNoCats').style.display = list.length ? 'none' : '';
        }
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('approveType').addEventListener('change', function () { fillApproveCategories(this.value, ''); });
        });
        document.addEventListener('click', function (e) {
            var b = e.target.closest('button');
            if (!b) return;
            if (b.classList.contains('js-edit-pending')) {
                document.getElementById('editId').value = b.dataset.id;
                document.getElementById('editName').value = b.dataset.name;
                document.getElementById('editExtra').value = b.dataset.extra || '';
                document.getElementById('editExtraWrap').style.display = b.dataset.type === 'Medication' ? '' : 'none';
            } else if (b.classList.contains('js-deny-pending')) {
                document.getElementById('denyId').value = b.dataset.id;
                document.getElementById('denyName').textContent = b.dataset.name;
                document.getElementById('denyReason').value = '';
            } else if (b.classList.contains('js-approve-pending')) {
                document.getElementById('approveId').value = b.dataset.id;
                document.getElementById('approveName').value = b.dataset.name;
                document.getElementById('approveType').value = b.dataset.type;
                fillApproveCategories(b.dataset.type, b.dataset.suggested);
            }
        });
    </script>
}
