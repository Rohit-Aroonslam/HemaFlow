@model Project.Models.CreateConditionViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Condition | Hema Flow";
}

<div class="row align-items-center mb-4 g-3">
    <div class="col-md-6">
        <h4 class="fw-700 mb-1" style="color: #0f172a;">Add Medical Condition</h4>
        <p class="text-muted small mb-0">Add a new condition to the list patients can select in their health profiles.</p>
    </div>
    <div class="col-md-6 d-flex justify-content-md-end">
        <a asp-controller="Admin" asp-action="MedicalConditions" class="btn btn-outline-secondary py-2 px-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Conditions
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-0">
            <div class="card-header">
                <i class="bi bi-clipboard2-plus text-primary me-2"></i>Condition Details
            </div>
            <div class="p-4">
                <form asp-action="CreateCondition" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EditId" value="@Model.EditId" />
                    <div class="mb-3">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Condition Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small"
                               placeholder="e.g. Sickle Cell Anemia" required value="@Model.Name">
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">ICD-10 Code</label>
                            <input type="text" name="Icd10Code" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small"
                                   placeholder="e.g. D57.1" value="@Model.Icd10Code">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Category <span class="text-danger">*</span></label>
                            <select name="CategoryId" class="form-select bg-light border-0 rounded-0 shadow-none py-2 small" required>
                                <option value="" disabled selected>Select a category...</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    @if (cat.Id == Model.CategoryId)
                                    {
                                        <option value="@cat.Id" selected>@cat.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label x-small text-muted text-uppercase fw-600 mb-1">Description (Optional)</label>
                        <textarea name="Description" class="form-control bg-light border-0 rounded-0 shadow-none py-2 small" rows="3"
                                  placeholder="Brief description of the condition...">@Model.Description</textarea>
                    </div>
                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                        <a asp-controller="Admin" asp-action="MedicalConditions" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-dark px-4">Save Condition</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-3 mb-0">
            <div class="fw-600 text-dark small mb-2"><i class="bi bi-lightbulb text-warning me-2"></i>Tips</div>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-2" style="font-size:0.78rem; color:#64748b;">
                <li><strong class="text-dark">Name:</strong> Use the full clinical name (e.g. "Myelodysplastic Syndrome", not "MDS").</li>
                <li><strong class="text-dark">ICD-10:</strong> Providing this code helps with clinical cross-referencing.</li>
                <li><strong class="text-dark">Category:</strong> If no suitable category exists, add one first under <a asp-controller="Admin" asp-action="GlobalCategories">Categories</a>.</li>
            </ul>
        </div>
    </div>
</div>